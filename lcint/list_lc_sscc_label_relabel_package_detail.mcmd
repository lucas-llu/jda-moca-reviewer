<command>
  <name>list lc sscc label relabel package detail</name>
  <description>list lc sscc label relabel package detail</description>
  <type>Local Syntax</type>
  <local-syntax> 
<![CDATA[

/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables.
 */
[select distinct ipv.ship_id,
        ipv.ordnum,
        ipv.client_id,
        ipv.subnum,
        invsub.uc_pkg_id
   from inventory_pckwrk_view ipv
   join invsub
     on ipv.subnum = invsub.subnum
  where ipv.subnum = @sscc_num]

]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-60987
