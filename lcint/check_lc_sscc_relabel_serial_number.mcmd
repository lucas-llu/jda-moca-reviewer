<command>
<name>check lc sscc relabel serial number</name>
<description>check lc sscc relabel serial number</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables.
 */
[select distinct dtlnum,
        prtnum,
        prt_client_id
   from inventory_view
  where subnum = @invtid]
|
get item serialization information
 where prtnum = @prtnum
   and prt_client_id = @prt_client_id
   and wh_id = @wh_id catch(-1403)
|
if (@? = 0)
{
    validate key exists
     where table = 'inv_ser_num'
       and key = 'invtid,ser_lvl'
       and invtid = @dtlnum
       and ser_lvl = @ser_lvl catch(@?)
    |
    if (@? <> 0)
    {
        set return status
         where status = 4100017
    }
}


]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-60987
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-10-22
    <p>
    This command is used to check lc sscc relabel serial number.
    </p>
]]>
</remarks>
</documentation>
</command>