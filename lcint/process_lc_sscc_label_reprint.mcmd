<command>
  <name>process lc sscc label reprint</name>
  <description>process lc sscc label reprint</description>
  <type>Local Syntax</type>
  <local-syntax> 
<![CDATA[

/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables.
 */
[select distinct sl.ship_id,
        sl.ordnum,
        sl.client_id,
        aiv.subnum
   from all_inventory_view aiv
   join shipment_line sl
     on aiv.ship_line_id = sl.ship_line_id
  where aiv.subnum = @sscc_num]
|
generate label
 where locale_id = nvl(@locale_id, @@locale_id)
   and label_name = 'Lc-PackingSsccLabel'
   and client_id = @client_id
   and wh_id = @wh_id
   and ship_id = @ship_id
   and ordnum = @ordnum
   and subnum = @subnum catch(@?)
|
if (@? = 0)
{
    print lbl label operations label
     where filename = @outfile_name
       and prtadr = @printer catch(@?)
}

]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-60987
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-10-22
    <p>
    This command is used to process lc sscc label reprint.
    </p>
]]>
</remarks>
</documentation>
</command>
