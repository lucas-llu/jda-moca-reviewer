<command>
<name>process pick list sequence</name>
<description>process pick list sequence</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

list policies
 where polcod = 'LC_PICK'
   and polvar = 'SORT_PICK_SEQUENCE'
   and polval = 'INSTALL'
   and rtstr1 = @client_id
   and wh_id = @wh_id
   and rtnum1 = 1 catch(-1403)
|
if (@? = 0)
{
    list lc pick list by sequence
    where sort_by = @rtstr2 catch(-1403)
    |
    if(@? = 0)
    {
        execute server command
         where cmd = "change record where table = 'pckwrk_hdr' and list_seqnum = '" || @seq || "'" || " and wrkref = '" || @wrkref || "'"
           and inline = 0
        |
        noop;
    }
}
else
{
    ^process pick list sequence
}

]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-67708
    @author Reko/Steven Chen
    @version 1.0.0
    @since 2026-04-02
    <p>
    This command is used to update the pick seq by srcloc.
    </p>
]]>
</remarks>
</documentation>
</command>