<command>
<name>check serial number capture required</name>
<description>check serial number capture required</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

list policies
 where polcod = 'LC_SERIAL_CAPTURE'
   and polvar = 'SKIP_SERIAL_CAPTURE'
   and polval = 'INSTALL'
   and rtstr1 = @prt_client_id
   and wh_id = nvl(@wh_id, @@wh_id)
   and rtnum1 = 1 catch(-1403)
|
if (@? = 0)
{
    list policies
     where polcod = 'LC_SERIAL_CAPTURE'
       and polvar = 'SKIP_SERIAL_CAPTURE'
       and polval = 'SKIP_ALL'
       and rtstr1 = @prt_client_id
       and wh_id = nvl(@wh_id, @@wh_id)
       and rtnum1 = 1 catch(-1403)
    |
    if (@? = 0 and @check_sernum is null)
    {
        set return status
         where status = 10737
    }
    |
    list policies
     where polcod = 'LC_SERIAL_CAPTURE'
       and polvar = 'SERIAL_OVERRIDE'
       and polval = 'INSTALLED'
       and rtstr1 = @prt_client_id
       and wh_id = nvl(@wh_id, @@wh_id)
       and rtnum1 = 1 catch(-1403)
    |
    if (@? = 0)
    {
        validate key exists
         where table = 'usr_uc_prtmst_cust_ref'
           and key = 'prtnum,prt_client_id,wh_id_tmpl,qualifier,value'
           and prtnum = @prtnum
           and prt_client_id = @prt_client_id
           and wh_id_tmpl = @wh_id
           and qualifier = 'AGG_SCAN'
           and value = '1' catch(@?)
        |
        if (@? = 0)
        {
            /* No existing MOCA list command, use select statement instead.
             * Retrieve data from some tables directly since there is no view for these tables.
             */
            [select pckwrk_view.pckqty,
                    prtftp_view.untcas
               from pckwrk_view
               join prtftp_view
                 on prtftp_view.prtnum = pckwrk_view.prtnum
                and prtftp_view.prt_client_id = pckwrk_view.prt_client_id
                and prtftp_view.wh_id = pckwrk_view.wh_id
                and prtftp_view.ftpcod = pckwrk_view.ftpcod
              where pckwrk_view.wrkref = @wrkref] catch(@?)
            |
            if (@pckqty < @untcas and @? = 0)
            {
                ^check serial number capture required
            }
            else
            {
                set return status
                 where status = 10737
            }
        }
        else
        {
            ^check serial number capture required
        }
    }
    else
    {
        ^check serial number capture required
    }
}
else
{
    ^check serial number capture required
}


]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-60057
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-11-20
    <p>
    This command is used to check serial number capture required.
    </p>
]]>
</remarks>
</documentation>
</command>