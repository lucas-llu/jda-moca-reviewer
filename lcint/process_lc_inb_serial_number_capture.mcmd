<command>
  <name>process lc inb serial number capture</name>
  <description>process lc inb serial number capture</description>
  <type>Local Syntax</type>
  <local-syntax> 
<![CDATA[

process lc current serial number required prtnum
 where subnum = @subnum
|
list lc inb serial number capture detail
 where subnum = @subnum
   and prtnum = @prtnum catch(-1403)
|
if (@? = 0)
{
    get item serialization information
     where prtnum = @prtnum
       and prt_client_id = @prt_client_id
       and wh_id = @wh_id
    |
    if (@untqty > 1)
    {
        /* Use update to update primary key in invdtl. */
        [update invdtl
            set untqty = to_number(@new_untqty),
                last_upd_dt = sysdate,
                last_upd_user_id = @@usr_id
          where dtlnum = @dtl]
        |
        generate next number
         where numcod = 'dtlnum'
        |
        create inventory detail
         where dtlnum = @nxtnum
           and prtnum = @prtnum
           and subnum = @subnum
           and wrkref = @wrkref
           and wrkref_dtl = @wrkref_dtl
           and ship_line_id = @ship_line_id
           and untcas = @untcas
           and untpak = @untpak
           and alcflg = @alcflg
           and invsts = 'A'
           and fifdte = sysdate
           and untqty = 1
           and ftpcod = @ftpcod
           and rcvdte = sysdate
           and lstmov = sysdate
           and lstdte = sysdate
           and lstcod = 'LSTPCK'
           and lst_usr_id = 'SLINADAPTER_2'
           and catch_qty = '0'
           and u_version = '1'
           and ins_dt = sysdate
           and last_upd_dt = sysdate
           and ins_user_id = 'SLINADAPTER_2'
           and last_upd_user_id = 'SLINADAPTER_2'
        |
        publish data
         where new_dtl = @nxtnum
    }
    |
    create inventory serial number
     where invtid = nvl(@new_dtl, @dtl)
       and ser_num_typ_id = @ser_num_typ_id
       and ser_num = @ser_num
       and ser_lvl = @ser_lvl
       and wh_id = @wh_id catch(@?)
    |
    if (@? <> 0)
    {
        list policies
         where polcod = 'LC_SERIAL_CAPTURE'
           and polvar = 'SEND_EMAIL'
           and polval = 'MAIL_FROM'
           and rtstr2 is not null
           and wh_id = @wh_id
           and rownum = 1 catch(-1403)
        |
        if (@? = 0)
        {
            publish data
             where mail_from = @rtstr1
            |
            list policies
             where polcod = 'LC_SERIAL_CAPTURE'
               and polvar = 'SEND_EMAIL'
               and polval = 'MAIL_TO'
               and rtstr2 is not null
               and wh_id = @wh_id
               and rownum = 1 catch(-1403)
            |
            if (@? = 0)
            {
                publish data
                 where mail_to = @rtstr2
                |
                send email
                 where send_to = @mail_to
                   and mail_from = nvl(@mail_from, 'swiftlog.donotreply@Kuehne-Nagel.com')
                   and subject = 'Issue With Aggregration Serial Number Exists in SwiftLOG '
                   and msg = 'Please check for this case: ' || @subnum catch(@?)
            }
        }
        |
        set return status
         where status = 11257
    }
}
else
{
    set return status
     where status = 4100018
}

]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-60057
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-12-29
    <p>
    This command is used to process lc inb serial number capture.
    </p>
]]>
</remarks>
</documentation>
</command>
