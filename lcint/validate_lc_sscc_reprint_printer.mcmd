<command>
<name>validate lc sscc reprint printer</name>
<description>validate lc sscc reprint printer</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

list printers
 where prtadr = @printer
   and wh_id = @wh_id catch(@?)
|
if (@? <> 0)
{
    set return status
     where status = 4100012
}


]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-60987
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-10-22
    <p>
    This command is used to validate lc sscc reprint printer.
    </p>
]]>
</remarks>
</documentation>
</command>