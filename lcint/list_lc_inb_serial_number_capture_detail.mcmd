<command>
  <name>list lc inb serial number capture detail</name>
  <description>list lc inb serial number capture detail</description>
  <type>Local Syntax</type>
  <local-syntax> 
<![CDATA[

/* No existing MOCA list command, use select statement instead. 
 * Retrieve data from some tables directly since there is no view for these tables.
 */
[select ipv.wh_id,
        ipv.prt_client_id,
        ipv.lodnum,
        ipv.subnum,
        ipv.dtlnum "DTL",
        ipv.stoloc,
        ipv.untqty,
        ipv.prtnum,
        ipv.wrkref,
        ipv.untcas,
        ipv.untpak,
        ipv.wrkref_dtl,
        ipv.ship_line_id,
        ipv.untqty -1 "NEW_UNTQTY",
        ipv.ftpcod,
        ps.ser_num_typ_id
   from inventory_pckwrk_view ipv
  inner
   join prtmst pm
     on pm.prtnum = ipv.prtnum
    and pm.wh_id_tmpl = ipv.wh_id
    and pm.prt_client_id = ipv.prt_client_id
  inner
   join prt_ser_typ ps
     on ps.prtnum = pm.prtnum
    and ps.prt_client_id = pm.prt_client_id
  inner
   join ser_num_typ st
     on st.ser_num_typ_id = ps.ser_num_typ_id
   left
   join inv_ser_num s
     on s.invtid = ipv.dtlnum
    and s.ser_num_typ_id = st.ser_num_typ_id
  where ipv.subnum = @subnum
    and ipv.prtnum = @prtnum
    and s.ser_num is null
    and rownum < 2]

]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-60057
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-12-29
    <p>
    This command is used to list lc inb serial number capture detail.
    </p>
]]>
</remarks>
</documentation>
</command>
