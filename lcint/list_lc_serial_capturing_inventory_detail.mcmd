<command>
<name>list lc serial capturing inventory detail</name>
<description>list lc serial capturing inventory detail</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

{
    get translated inventory identifier
     where id = @id
       and wh_id = @wh_id
    |
    publish data
     where lodnum = @lodnum
       and subnum = @subnum
       and colnam = @colnam
}
|
publish data
 where prtnum = @prtnum
|
if (@lodnum is null)
{
    hide stack variable
     where name = 'lodnum'
}
|
if (@subnum is null)
{
    hide stack variable
     where name = 'subnum'
}
|
/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables.
 */
[select prtnum,
        sum(untqty) total_qty
   from inventory_view
  where @+lodnum
    and @+subnum
    and wh_id = @wh_id
    and prtnum = @prtnum
  group by prtnum]
|
filter data
 where moca_filter_level = 1
   and pallet_type = @colnam


]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-60057
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-11-20
    <p>
    This command is used to list lc serial capturing inventory detail.
    </p>
]]>
</remarks>
</documentation>
</command>