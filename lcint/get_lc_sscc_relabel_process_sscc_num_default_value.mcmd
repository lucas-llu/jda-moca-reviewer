<command>
  <name>get lc sscc relabel process sscc num default value</name>
  <description>get lc sscc relabel process sscc num default value</description>
  <type>Local Syntax</type>
  <local-syntax>
    
<![CDATA[

get lc sscc relabel process sscc num visible flag
 where invtid = @invtid
|
if (@visible_flag = 'N')
{
    publish data
     where sscc_num = @invtid
}

]]>    
  </local-syntax>
  <argument name="invtid" required="yes" datatype="string">Inventory ID</argument>
  <documentation>
    <remarks>
      @author Kevin Wang
      @since 2026-04-02
      SWIFTLEX-67708
      The command is used to get lc sscc relabel process sscc num default value.
    </remarks>
  </documentation>
</command>
