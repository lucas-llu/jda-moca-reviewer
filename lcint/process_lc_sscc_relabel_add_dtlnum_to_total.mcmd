<command>
  <name>process lc sscc relabel add dtlnum to total</name>
  <description>process lc sscc relabel add dtlnum to total</description>
  <type>Local Syntax</type>
  <local-syntax>
    
<![CDATA[

/* No list command, use select insead.
   Select from table directly as no view for the table. */
[select session_id tmp_session_id,
        value total_dtlnum_value
   from usr_uc_rf_process_session
  where process_name = @process_name
    and devcod = nvl(@devcod, @@devcod)
    and wh_id = nvl(@wh_id, @@wh_id)
    and step_name = 'total_dtlnum'
    and step_seqnum = 40] catch(-1403)
|
if (@? = 0)
{
    publish data
     where validate_dtlnum_in_total = instr(@total_dtlnum_value, @dtlnum)
    |
    if (@validate_dtlnum_in_total != 0)
    {
        set return status
         where code = 4100028
    }
    else
    {
        change record
         where table = 'usr_uc_rf_process_session'
           and session_id = @tmp_session_id
           and process_name = @process_name
           and devcod = nvl(@devcod, @@devcod)
           and wh_id = nvl(@wh_id, @@wh_id)
           and step_name = 'total_dtlnum'
           and step_seqnum = 40
           and value = @total_dtlnum || @dtlnum || "," catch(-12899)
        |
        if (@? = -12899)
        {
            set return status
             where code = 4100027
        }
    }
}
else
{
    create record
     where table = 'usr_uc_rf_process_session'
       and process_name = @process_name
       and devcod = nvl(@devcod, @@devcod)
       and wh_id = nvl(@wh_id, @@wh_id)
       and step_name = 'total_dtlnum'
       and step_seqnum = 40
       and value = @dtlnum || ","
}

]]>    
  </local-syntax>
  <argument name="wh_id" required="yes" datatype="string">Warehouse ID</argument>
  <documentation>
    <remarks>
      @author Kevin Wang
      @since 2026-04-01
      SWIFTLEX-67708
      The command is used to process lc add dtlnum to total for sscc relabel.
    </remarks>
  </documentation>
</command>
