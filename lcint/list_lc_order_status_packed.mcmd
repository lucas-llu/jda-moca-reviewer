<command>
<name>list lc order status packed</name>
<description>list lc order status packed</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables.
 */
[select value
   from usr_uc_ord_cust_ref
  where client_id = @client_id
    and ordnum = @ordnum
    and wh_id = @wh_id
    and qualifier = 'order_status'
    and rcv_sequence = (select max(rcv_sequence)
                          from usr_uc_ord_cust_ref
                         where client_id = @client_id
                           and ordnum = @ordnum
                           and wh_id = @wh_id
                           and qualifier = 'order_status')]


]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-58488
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-10-14
    <p>
    This command is used to list lc order status packed.
    </p>
]]>
</remarks>
</documentation>
</command>