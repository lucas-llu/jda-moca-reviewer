<command>
<name>list lc packing list summary data</name>
<description>list lc packing list summary data</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

validate stack variable not null
 where name = 'ship_id'
|
/*SQL select statement used as no standard list command or view is available
 *The ship_id is used to limit the result set of this sub select to be very small */
[select count(pkg_dtl.uc_pkg_id) hu_cnt,
        to_char(sum(round((pkg_dtl.uc_grswgt / 1000), 3)), 'FM9999999990.000') tol_grswgt,
        to_char(sum(round((pkg_dtl.uc_netwgt / 1000), 3)), 'FM9999999990.000') tol_netwgt,
        to_char(sum(round((pkg_dtl.uc_pkglen * pkg_dtl.uc_pkgwdt * pkg_dtl.uc_pkghgt), 3)), 'FM9999999990.000') tol_vol
   from (select distinct usr_uc_package_detail.uc_pkg_id,
                usr_uc_package_detail.uc_grswgt,
                usr_uc_package_detail.uc_netwgt,
                usr_uc_package_detail.uc_pkglen,
                usr_uc_package_detail.uc_pkgwdt,
                usr_uc_package_detail.uc_pkghgt
           from shipment_line sl
           join all_inventory_view aiv
             on aiv.ship_line_id = sl.ship_line_id
           left
           join invsub
             on invsub.subnum = aiv.subnum
            and invsub.lodnum = aiv.lodnum
           left
           join invsub_hist
             on invsub_hist.subnum = aiv.subnum
            and invsub_hist.lodnum = aiv.lodnum
           join usr_uc_package_detail
             on usr_uc_package_detail.uc_pkg_id = nvl(invsub.uc_pkg_id, invsub_hist.uc_pkg_id)
          where sl.ship_id = @ship_id) pkg_dtl] catch(-1403)

]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-60323
    @author Reko/Lydia Luo
    @version 1.0.0
    @since 2025-11-19

    <p>
        This command is used to list packing list report summary data.
    </p>
]]>
</remarks>

</documentation>
</command>