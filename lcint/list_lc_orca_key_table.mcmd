<command>
  <name>list lc orca key table</name>
  <description>list lc orca key table</description>
  <type>Local Syntax</type>
  <local-syntax>
<![CDATA[
/*Using direct SQL on table to avoid stack corruption and no views available*/
[select *
   from usr_lc_orca_key_table] catch(-1403)
]]>
</local-syntax>
</command>