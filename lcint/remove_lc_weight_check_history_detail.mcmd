<command>
  <name>remove lc weight check history detail</name>
  <description>remove lc weight check history detail</description>
  <type>Local Syntax</type>
  <local-syntax>
    
<![CDATA[

remove record
 where table = 'usr_lc_weight_check_hist_dtl'
   and history_dtl_id = @history_dtl_id
   and history_id = @history_id

]]>    
  </local-syntax>
  <argument name="history_dtl_id" required="yes" datatype="string">Weight Check History Detail Id</argument>
  <argument name="history_id" required="yes" datatype="string">Weight Check History Id</argument>
  <documentation>
    <remarks>
      @author Kevin Wang
      @since 2025-10-21
      SWIFTLEX-57791
      remove lc weight check detail history
    </remarks>
  </documentation>
</command>
