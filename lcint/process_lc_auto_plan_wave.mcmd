<command>
<name>process lc auto plan wave</name>
<description>process lc auto plan wave</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

list order lines available for wave planning 
where rule_nam = @rule_nam  
and wh_id = @wh_id
and offset = 0  
and sumflg = 1 catch(-1403) >> res
|
if(rowcount(@res) > 0)
{
    convert column results to string 
        where resultset = @res
          and colnam = 'stcust'
          and separator = ''','''
    |
    publish data where stcust_where = '''' || @result_string || ''''
    |
    /* No existing MOCA list command, use select statement instead.
     * Retrieve data from some tables directly since there is no view for these tables.
     * remove the duplicated stcust
     * @stcust_where:raw will not be empty or cause SQL Injection Risk as they are already validated in line 14.
     */
    [select distinct stcust from ord where stcust in (@stcust_where:raw)]
    |
    /* No existing MOCA list command, use select statement instead.
     * Retrieve data from some tables directly since there is no view for these tables.
     * get the order line info.
     */
    [select ord_line.ordnum, 
            ord_line.client_id, 
            ord_line.ordlin, 
            ord_line.ordsln, 
            ord_line.wh_id 
       from ord_line 
       join ord 
         on ord.ordnum = ord_line.ordnum 
        and ord.client_id = ord_line.client_id 
        and ord.wh_id = ord_line.wh_id 
      where ord_line.wh_id = @wh_id 
        and ord_line.pckqty > 0 
        and ord_line.cancelled_flg = 0 
        and ord.stcust = @stcust 
    ] >> res
    |
    convert column results to string 
      where resultset = @res 
        and colnam = 'ordnum' 
        and separator = ',' 
    |
    publish data 
      where ordnum_list=@result_string 
    |
    convert column results to string 
      where resultset = @res 
        and colnam = 'ordlin' 
        and separator = ',' 
    |
    publish data 
      where ordlin_list=@result_string 
    |
    convert column results to string 
      where resultset = @res 
        and colnam = 'ordsln' 
        and separator = ',' 
    |
    publish data 
      where ordsln_list=@result_string 
    |
    convert column results to string 
      where resultset = @res 
        and colnam = 'client_id' 
        and separator = ',' 
    |
    publish data 
      where client_id_list=@result_string 
    |
    convert column results to string 
      where resultset = @res 
        and colnam = 'wh_id' 
        and separator = ',' 
    |
    publish data 
      where wh_id_list=@result_string 
    |
    publish data 
      where prefix = 'B' || to_char(sysdate + 5.5 / 24, 'DDMMYY') 
    |
    /* No existing MOCA list command, use select statement instead.
     * Retrieve data from some tables directly since there is no view for these tables.
     * get total wave number of current day.
     */
    [select count(schbat) seq from pckbat where schbat like @prefix || '%']
    |
    publish data 
      where schbat = @prefix || to_char(@seq + 1, '00000')
    |
    plan shipment wave by order selection 
      where rule_nam = @rule_nam
        and wh_id = @wh_id
        and schbat = @schbat
}


]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-60987
    @author Reko/Steven Chen
    @version 1.0.0
    @since 2026-03-18
    <p>
    This command is used to auto plan wave.
    </p>
]]>
</remarks>
</documentation>
</command>