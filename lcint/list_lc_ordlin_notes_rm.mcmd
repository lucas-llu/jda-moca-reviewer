<command>
<name>list lc ordlin notes rm</name>
<description>list lc ordlin notes rm</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

/* No existing MOCA list command, use select statement instead. 
 * Retrieve data from some tables directly since there is no view for these tables.
 */
[select shipment_line.ship_id,
        shipment_line.ship_line_id,
        ord_line_note.client_id,
        ord_line_note.ordnum,
        ord_line_note.ordlin,
        ord_line_note.ordsln,
        ord_line_note.nottyp,
        ord_line_note.notlin,
        ord_line_note.wh_id,
        ord_line_note.nottxt,
        ord_line_note.edtflg,
        ord_line_note.u_version,
        ord_line_note.ins_dt,
        ord_line_note.last_upd_dt,
        ord_line_note.ins_user_id,
        ord_line_note.last_upd_user_id,
        ord_line_note.is_purged
   from ord_line_note
   left
   join shipment_line
     on shipment_line.client_id = ord_line_note.client_id
    and shipment_line.ordnum = ord_line_note.ordnum
    and shipment_line.ordlin = ord_line_note.ordlin
    and shipment_line.ordsln = ord_line_note.ordsln
    and shipment_line.wh_id = ord_line_note.wh_id
    and shipment_line.linsts != 'B'
  where @+shipment_line.ship_id
    and @+ord_line_note.ordnum
    and @+ord_line_note.ordlin
    and @+ord_line_note.ordsln
    and @+ord_line_note.wh_id
    and @+ord_line_note.client_id
  order by ship_line_id,
        ord_line_note.wh_id,
        ord_line_note.client_id,
        ord_line_note.ordnum,
        ord_line_note.ordlin,
        ord_line_note.ordsln,
        ord_line_note.notlin]

]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-58488
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-10-14
    <p>
    This command is used to list lc ordlin notes rm.
    </p>
]]>
</remarks>
</documentation>
</command>