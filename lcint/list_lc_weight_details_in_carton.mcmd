<command>
  <name>list lc weight details in carton</name>
  <description>list lc weight details in carton</description>
  <type>Local Syntax</type>
  <local-syntax>
    
<![CDATA[

/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables. */
[select row_number() over(order by tbl.prtnum) as seq,
        tbl.prtnum,
        tbl.untqty,
        tbl.grswgt,
        tbl.total_grswgt,
        tbl.netwgt,
        tbl.total_netwgt,
        tbl.subnum,
        tbl.ctncod,
        tbl.ctnwgt,
        tbl.ctnwlm,
        tbl.custmor,
        tbl.client_id,
        min(tbl.netwgt) over(partition by tbl.subnum) lp_weight,
        sum(tbl.total_grswgt) over(partition by tbl.subnum) total_weight_without_box
   from (select inventory_view.prtnum,
                pckwrk_view.ctncod,
                pckwrk_view.subnum,
                ctnmst.ctnwlm / 1000 ctnwlm,
                ctnmst.ctnwgt / 1000 ctnwgt,
                sum(inventory_view.untqty) untqty,
                prtftp_dtl.grswgt / 1000 grswgt,
                prtftp_dtl.grswgt * sum(inventory_view.untqty) / 1000 total_grswgt,
                prtftp_dtl.netwgt / 1000 netwgt,
                prtftp_dtl.netwgt * sum(inventory_view.untqty) / 1000 total_netwgt,
                pckwrk_view.stcust custmor,
                inventory_view.prt_client_id client_id
           from inventory_view
           join pckwrk_view
             on pckwrk_view.subnum = inventory_view.subnum
            and pckwrk_view.wrktyp = 'K'
           join ctnmst
             on ctnmst.ctncod = pckwrk_view.ctncod
            and ctnmst.wh_id = pckwrk_view.wh_id
           join prtftp_dtl
             on prtftp_dtl.prtnum = inventory_view.prtnum
            and prtftp_dtl.ftpcod = inventory_view.ftpcod
            and prtftp_dtl.prt_client_id = inventory_view.prt_client_id
            and prtftp_dtl.wh_id = inventory_view.wh_id
            and prtftp_dtl.uomcod = 'EA'
          where inventory_view.subnum = @subnum
            and inventory_view.wh_id = @wh_id
          group by inventory_view.prtnum,
                prtftp_dtl.grswgt,
                prtftp_dtl.netwgt,
                pckwrk_view.ctncod,
                pckwrk_view.subnum,
                ctnmst.ctnwgt,
                ctnmst.ctnwlm,
                pckwrk_view.stcust,
                inventory_view.prt_client_id) tbl
  group by tbl.prtnum,
        tbl.untqty,
        tbl.grswgt,
        tbl.total_grswgt,
        tbl.netwgt,
        tbl.total_netwgt,
        tbl.subnum,
        tbl.ctncod,
        tbl.ctnwgt,
        tbl.ctnwlm,
        tbl.custmor,
        tbl.client_id]

]]>    
  </local-syntax>
  <argument name="wh_id" required="yes" datatype="string">Warehouse ID</argument>
  <argument name="subnum" required="yes" datatype="string">Sub-LPN</argument>
  <documentation>
    <remarks>
      @author Kevin Wang
      @since 2025-10-14
      SWIFTLEX-57791
      list lc weight details in carton
    </remarks>
  </documentation>
</command>
