<command>
<name>list lc serial capturing package lodnum</name>
<description>list lc serial capturing package lodnum</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables.
 */
[select ordnum,
        prtnum,
        lodnum,
        client_id,
        sum(untqty) total_qty
   from inventory_pckwrk_view
  where lodnum = @invtid
    and wh_id = @wh_id
  group by ordnum,
        prtnum,
        lodnum,
        client_id]


]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-60057
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-11-20
    <p>
    This command is used to list lc serial capturing package lodnum.
    </p>
]]>
</remarks>
</documentation>
</command>