<command>
  <name>list lc weight check history detail</name>
  <description>list lc weight check history detail</description>
  <type>Local Syntax</type>
  <local-syntax>
    
<![CDATA[

/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables. */
[select *
   from usr_lc_weight_check_hist_dtl
  where @+history_dtl_id
    and @+history_id
    and @+prtnum
    and @+untqty
    and @+wh_id
    and @+client_id
    and @+srcloc
    and @+carton_code
    and @+subnum
    and @+ordnum
    and @+ship_id
    and @+pick_usr_id
    and @+policy_condition
    and @+reason_code
    and @+insert_datetime]

]]>    
  </local-syntax>
  <argument name="history_dtl_id" datatype="string">Weight Check History Detail Id</argument>
  <argument name="history_id" datatype="string">Weight Check History Id</argument>
  <argument name="prtnum" datatype="string">Item Number</argument>
  <argument name="untqty" datatype="int">Unit Quantity</argument>
  <argument name="wh_id" datatype="string">Warehouse Id</argument>
  <argument name="client_id" datatype="string">Client Id</argument>
  <argument name="srcloc" datatype="string">Source Location</argument>
  <argument name="carton_code" datatype="string">Carton Code</argument>
  <argument name="subnum" datatype="string">Sub Lpn</argument>
  <argument name="ordnum" datatype="string">Order Number</argument>
  <argument name="ship_id" datatype="string">Shipment Id</argument>
  <argument name="pick_usr_id" datatype="string">Pick User Id</argument>
  <argument name="policy_condition" datatype="string">Policy Condition</argument>
  <argument name="reason_code" datatype="string">Reason Code</argument>
  <argument name="insert_datetime" datatype="date">Insert Datetime</argument>
  <documentation>
    <remarks>
      @author Kevin Wang
      @since 2025-10-21
      SWIFTLEX-57791
      list lc weight check detail history
    </remarks>
  </documentation>
</command>
