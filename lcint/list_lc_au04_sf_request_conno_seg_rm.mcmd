<command>
<name>list lc au04 sf request conno seg rm</name>
<description>list lc au04 sf request conno seg rm</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

list lc au04 sf request package trade details catch(-1403)
|
list lc au04 sf request conno seg sender address
 where wh_id = @wh_id catch(-1403)
|
convert time zone
 where datetime = sysdate
   and dst_tz = @tim_zon_cd
|
/*In case of multiple notes type maintained for multiple orders in a shipment to send in special instructions segment, fetching the combined list.*/
/* Retrieve data from some tables directly since there is no view for these tables.
 * There is no existing command, use select statement instead.
 */
[select distinct '''' || shipment_line.ordnum || '''' ordnum
   from shipment_line
  where shipment_line.ship_id = @ship_id] >> res
|
convert column results to string
 where colnam = 'ordnum'
   and res = @res
|
publish data
 where ordnum_list = @result_string
|
/* Retrieve data from some tables directly since there is no view for these tables.
 * There is no existing command, use select statement instead.
 */
[select substr(max(nottxt), 1, 30) sp1
   from ord_note
  where ordnum in (@ordnum_list:raw)
    and wh_id = @wh_id
    and client_id = @client_id
    and upper(nottyp) = 'LABELSP1'] catch(-1403)
|
/* Retrieve data from some tables directly since there is no view for these tables.
 * There is no existing command, use select statement instead.
 */
[select substr(max(nottxt), 1, 30) sp2
   from ord_note
  where ordnum in (@ordnum_list:raw)
    and wh_id = @wh_id
    and client_id = @client_id
    and upper(nottyp) = 'LABELSP2'] catch(-1403)
|
/* Retrieve data from some tables directly since there is no view for these tables.
 * There is no existing command, use select statement instead.
 */
[select substr(max(nottxt), 1, 30) sp3
   from ord_line_note
  where ordnum in (@ordnum_list:raw)
    and wh_id = @wh_id
    and client_id = @client_id
    and upper(nottyp) = 'LABELSP3'] catch(-1403)
|
list lc au04 sf request conno seg address
 where ship_id = @ship_id
   and wh_id = @wh_id catch(-1403)
|
/*Below block will determine the values to be set for fields Client/Order Type/Carrrier/WaveSet which will come from Return String Two of this Policy.*/
{
    /*First checking if we have the exact match of the policy in Return String One.*/
    list policies
     where polcod = 'LC_SF_WEB_SERVICE'
       and polvar = 'SENDER_ACC'
       and polval = 'INSTALLED'
       and wh_id = @wh_id
       and rtstr1 = @client_id || '|' || @ordtyp || '|' || @carcod || '|' || @wave_set
       and rownum < 2 catch(-1403)
    |
    if (@? != 0)
    {
        list policies
         where polcod = 'LC_SF_WEB_SERVICE'
           and polvar = 'SENDER_ACC'
           and polval = 'INSTALLED'
           and wh_id = @wh_id
           and rtstr1 = @client_id || '|' || @ordtyp || '|' || @carcod || '|ANY'
           and rownum < 2 catch(-1403)
        |
        if (@? != 0)
        {
            /*If not exact match for Client/Order Type/Carrier/Service Level, then will check for Service Level= ANY and rest values need to match exactly.*/
            list policies
             where polcod = 'LC_SF_WEB_SERVICE'
               and polvar = 'SENDER_ACC'
               and polval = 'INSTALLED'
               and wh_id = @wh_id
               and rtstr1 = @client_id || '|' || @ordtyp || '|ANY|ANY'
               and rownum < 2 catch(-1403)
            |
            if (@? != 0)
            {
                /*If not exact match for Client/Order Type/Carrier/Service Level, then will check for Service Level= ANY and rest values need to match exactly.*/
                list policies
                 where polcod = 'LC_SF_WEB_SERVICE'
                   and polvar = 'SENDER_ACC'
                   and polval = 'INSTALLED'
                   and wh_id = @wh_id
                   and rtstr1 = @client_id || '|ANY|ANY|ANY'
                   and rownum < 2 catch(-1403)
                |
                if (@? = 0)
                {
                    publish data
                     where rtstr2 = @rtstr2
                }
            }
            else
            {
                publish data
                 where rtstr2 = @rtstr2
            }
        }
        else
        {
            publish data
             where rtstr2 = @rtstr2
        }
    }
    else
    {
        publish data
         where rtstr2 = @rtstr2
    }
    |
    publish data
     where sendaccno = @rtstr2
}
|
/*Below block will determine the values to be set for fields Carrier/Service Name/Account Number/Freight Method/Auto-Consolidate which will come from Return String Two of this Policy.
   Return String One will contain the fields which will determine the matching values returned by Return String Two, to send to TMS system .*/
{
    /*First checking if we have the exact match of the policy in Return String One.*/
    list policies
     where polcod = 'LC_SF_WEB_SERVICE'
       and polvar = 'SET_INPUT_OUTPUT_MAPPING'
       and polval = 'INSTALLED'
       and wh_id = @wh_id
       and rtstr1 = @client_id || '|' || @ordtyp || '|' || @carcod || '|' || @srvlvl
       and rownum < 2 catch(-1403)
    |
    if (@? != 0)
    {
        if (@srvlvl is not null)
        {
            /*If not exact match for Client/Order Type/Carrier/Service Level, then will check for Carrier= ANY and rest values need to match exactly.*/
            list policies
             where polcod = 'LC_SF_WEB_SERVICE'
               and polvar = 'SET_INPUT_OUTPUT_MAPPING'
               and polval = 'INSTALLED'
               and wh_id = @wh_id
               and rtstr1 = @client_id || '|' || @ordtyp || '|ANY|' || @srvlvl
               and rownum < 2 catch(-1403)
        }
        |
        if (@carcod is not null)
        {
            /*If not exact match for Client/Order Type/Carrier/Service Level, then will check for Service Level= ANY and rest values need to match exactly.*/
            list policies
             where polcod = 'LC_SF_WEB_SERVICE'
               and polvar = 'SET_INPUT_OUTPUT_MAPPING'
               and polval = 'INSTALLED'
               and wh_id = @wh_id
               and rtstr1 = @client_id || '|' || @ordtyp || '|' || @carcod || '|ANY'
               and rownum < 2 catch(-1403)
        }
        |
        if (@rtstr2 is null)
        {
            /*If not exact match for Client/Order Type/Carrier/Service Level, then will check for Carrier= ANY and Service Level = ANY and rest values need to match exactly.*/
            list policies
             where polcod = 'LC_SF_WEB_SERVICE'
               and polvar = 'SET_INPUT_OUTPUT_MAPPING'
               and polval = 'INSTALLED'
               and wh_id = @wh_id
               and rtstr1 = @client_id || '|' || @ordtyp || '|ANY|ANY'
               and rownum < 2 catch(-1403)
        }
        |
        publish data
         where rtstr2 = @rtstr2
    }
    |
    publish data
     where rtstr2 = @rtstr2
    |
    /*Splitting the rows to multiple columns to set these values.*/
    if (@rtstr2 is not null)
    {
        convert list
         where liststring = @rtstr2
           and type = 'L'
           and separator = '|' >> res
        |
        convert column to multicolumn
         where colnam = 'retstr'
           and count = 5
           and res = @res
    }
}
|
if (@lc_ctncod is not null)
{
    list policies
     where polcod = 'LC_SF_WEB_SERVICE'
       and polvar = 'LABEL_TYPE'
       and polval = @ordtyp
       and wh_id = @wh_id
       and rtstr1 = @client_id
       and rownum < 2 catch(-1403)
    |
    if (@? = 0 and @tradeagreetyp = 'Y')
    {
        publish data
         where lc_lbltyp = @rtstr2
    }
}
|
/*Publishing final result set, values NA for fields at the end will be sent as NULL.*/
filter data
 where moca_filter_level = 4
   and recph = @recph
   and rec_add1 = @rec_add1
   and rec_add2 = @rec_add2
   and multiplylwh = 'Yes'
   and printer = @printer
   and sendaccno = @sendaccno
   and matchsendertoaccountno = 'YES'
   and sp1 = @sp1
   and sp2 = @sp2
   and sp3 = @sp3
   and carriername = decode(@retstr_0, 'NA', '', @retstr_0)
   and service = decode(@retstr_1, 'NA', '', @retstr_1)
   and accno = decode(@retstr_2, 'NA', '', @retstr_2)
   and freightmethod = decode(@retstr_3, 'NA', '', @retstr_3)
   and autoconsolidate = decode(@retstr_4, 'NA', '', @retstr_4)
   and com1 = @lc_early_dlvdte
   and com2 = @lc_late_dlvdte
   and com3 = @lc_schbat
   and com4 = @com4
   and lc_lbltyp = decode(@manual_trg, '1', @pdf_lbltyp, @lc_lbltyp)

]]>
</local-syntax>
<argument name="wh_id" required="no" datatype="string">warehouse id</argument>
<argument name="package_id" required="yes" datatype="string">lpn or sublpn or sscc</argument>
<argument name="ship_id" required="no" datatype="string">shipment id</argument>
<argument name="client_id" required="no" datatype="string">client id</argument>
<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-64040
    @author Reko Lydia Luo
    @version 1.0.0
    @since 2026-02-04
    <p>
     Command will be used to fetch the information for the most of 
     the fields to send under CONNOTE segment of the web service request.
    </p>
]]>
</remarks>
</documentation>
</command>