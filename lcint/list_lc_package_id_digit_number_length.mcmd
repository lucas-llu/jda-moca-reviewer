<command>
<name>list lc package id digit number length</name>
<description>list lc package id digit number length</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables.
 * Use Oracle Function REGEXP_COUNT to count the number of digits in the package id.
 */
[select regexp_count(@package_id, '[0-9]') digit
   from dual]




]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-60987
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-10-22
    <p>
    This command is used to list lc package client id.
    </p>
]]>
</remarks>
</documentation>
</command>