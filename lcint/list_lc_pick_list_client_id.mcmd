<command>
<name>list lc pick list client id</name>
<description>list lc pick list client id</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables. */
[select client_id
   from pckwrk_view
  where list_id = @list_id
    and rownum = 1]




]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-63062
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2026-02-05
    <p>
    This command is used to list lc pick list client id.
    </p>
]]>
</remarks>
</documentation>
</command>