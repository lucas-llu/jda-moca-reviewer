<command>
<name>get lc use srcloc deposit</name>
<description>get lc use srcloc deposit</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

list lc package client id
 where subnum = @subnum catch(-1403)
|
list policies
 where polcod = 'LC_SERIAL_CAPTURE'
   and polvar = 'DEPOSIT_LOC'
   and polval = 'EXCEPTION_LOC'
   and wh_id = @wh_id
   and rtstr1 = @client_id 
   and rtnum1 = 1 catch(@?)




]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-67708
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2026-03-31
    <p>
    This command is used to get lc use srcloc deposit.
    </p>
]]>
</remarks>
</documentation>
</command>