<command>
<name>list lc order status picked detail</name>
<description>list lc order status picked detail</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

/* No existing MOCA list command, use select statement instead. */
[select distinct o.ordnum,
        o.ordtyp,
        o.wh_id,
        pv.ship_id,
        o.client_id
   from pckwrk_view pv
   join wrkque w
     on (w.list_id = pv.list_id or w.wrkref = pv.wrkref)
   join ord o
     on o.wh_id = pv.wh_id
    and o.client_id = pv.client_id
    and o.ordnum = pv.ordnum
  where pv.wrkref = @wrkref
    and pv.wh_id = @wh_id
    and pv.wrktyp in ('P', 'B')]


]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-58488
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-10-14
    <p>
    This command is used to list lc order status picked detail.
    </p>
]]>
</remarks>
</documentation>
</command>