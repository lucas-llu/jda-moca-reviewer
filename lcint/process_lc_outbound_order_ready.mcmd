<command>
<name>process lc outbound order ready</name>
<description>process lc outbound order ready</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

get integrator system id
 where systyp = 'WMD'
|
sl_log event
 where evt_id = 'LC-OUTBOUND-ORD-READY'
   and sys_id = @sys_id
   and ifd_data_ptr = NULL
   and wh_id = @wh_id
   and client_id = @client_id
   and ordnum = @ordnum
   and order_status = @order_status;
execute server command
 where cmd = "get integrator system id where systyp = 'WMD' | process usr outbound order customer ref where client_id = '" || @client_id || "' and ordnum = '" || @ordnum || "' and wh_id = '" || @wh_id || "' and qualifier = 'order_status' and value = '" || @order_status ||"'"
   and inline = 0


]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-58488
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-10-14
    <p>
    This command is used to process lc outbound order ready.
    </p>
]]>
</remarks>
</documentation>
</command>