<command>
<name>list lc serial capture inventory</name>
<description>list lc serial capture inventory</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

if (@lodnum is null)
{
    hide stack variable
     where name = 'lodnum'
}
|
if (@subnum is null)
{
    hide stack variable
     where name = 'subnum'
}
|
/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables.
 */
[select prt_client_id client_id,
        prtnum,
        subnum
   from inventory_view
  where @+lodnum
    and @+subnum
  group by prt_client_id,
        prtnum,
        subnum]


]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-60057
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-11-20
    <p>
    This command is used to list lc serial capture inventory.
    </p>
]]>
</remarks>
</documentation>
</command>