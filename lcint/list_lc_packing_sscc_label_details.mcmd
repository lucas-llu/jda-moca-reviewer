<command>
<name>list lc packing sscc label details</name>
<description>list lc packing sscc label details</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

validate lc packing sscc label fields
|
/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables.
 * Use poldat instead of poldat_view for better performance.
 * We do not place this complex SQL in a separate command because the business logic cannot separate this complex SQL from field validation logic.
 * The ship_id is used to limit the result set of this sub select to be very small *
 */
[select @rpt_field_str01:raw rpt_field01,
        @rpt_field_str02:raw rpt_field02,
        @rpt_field_str03:raw rpt_field03,
        @rpt_field_str04:raw rpt_field04,
        @rpt_field_str05:raw rpt_field05,
        @rpt_field_str06:raw rpt_field06,
        @rpt_field_str07:raw rpt_field07,
        cast(from_tz(cast(to_date(ord_note.nottxt) AS TIMESTAMP), SESSIONTIMEZONE) AT TIME ZONE time_zone.rtstr2 AS DATE) pack_dt,
        @rpt_field_str10:raw client_id,
        invdtl.prtnum,
        sum(invdtl.untqty) untqty,
        @rpt_field_str16:raw rpt_field16,
        @rpt_field_str17:raw rpt_field17,
        @rpt_field_str18:raw rpt_field18,
        @rpt_field_str19:raw rpt_field19,
        @rpt_field_str20:raw rpt_field20,
        @rpt_field_str21:raw rpt_field21,
        @rpt_field_str22:raw rpt_field22,
        @rpt_field_str23:raw rpt_field23,
        @rpt_field_str25:raw rpt_field25,
        @rpt_field_str27:raw rpt_field27,
        @rpt_field_str28:raw rpt_field28,
        @rpt_field_str29:raw rpt_field29,
        cur_cas_tbl.cur_cas curcas,
        @rpt_field_str31:raw rpt_field31,
        @rpt_field_str32:raw rpt_field32,
        @rpt_field_str33:raw rpt_field33,
        to_char(round(usr_uc_package_detail.uc_grswgt / 1000, 3), 'FM999990.000') total_wgt
   from shipment_line
   join ord
     on shipment_line.ordnum = ord.ordnum
    and shipment_line.client_id = ord.client_id
    and shipment_line.wh_id = ord.wh_id
    and shipment_line.linsts <> 'B'
   join wh
     on shipment_line.wh_id = wh.wh_id
   join adrmst wh_adrmst
     on wh_adrmst.adr_id = wh.adr_id
   join adrmst sf_adrmst
     on sf_adrmst.adr_id = ord.st_adr_id
   join client
     on client.client_id = ord.client_id
   join invdtl
     on invdtl.ship_line_id = shipment_line.ship_line_id
   join invsub
     on invsub.subnum = invdtl.subnum
   join (select tbl.wrkref,
                tbl.wrkref_dtl,
                row_number() over(order by tbl.ordnum, tbl.ordlin, tbl.prtnum, tbl.srcloc, tbl.wrkref, tbl.wrkref_dtl) cur_cas
           from (select pckwrk_view.ordnum,
                        pckwrk_view.ordlin,
                        pckwrk_view.prtnum,
                        pckwrk_view.srcloc,
                        inventory_view.wrkref,
                        inventory_view.wrkref_dtl
                   from pckwrk_view
                   join inventory_view
                     on pckwrk_view.wrkref = inventory_view.wrkref
                    and pckwrk_view.wrkref_dtl = inventory_view.wrkref_dtl
                    and pckwrk_view.wh_id = inventory_view.wh_id
                  where pckwrk_view.ordnum = @ordnum
                    and lodlvl = 'S'
                    and wrktyp = 'P'
                    and oprcod = 'LPCKORD'
                 union
                 select pckwrk_view.ordnum,
                        pckwrk_view.ordlin,
                        pckwrk_view.prtnum,
                        pckwrk_view.srcloc,
                        pckwrk_view.wrkref,
                        pckwrk_view.wrkref_dtl
                   from pckwrk_view
                  where pckwrk_view.ordnum = @ordnum
                    and pckwrk_view.wrktyp = 'K') tbl) cur_cas_tbl
     on (cur_cas_tbl.wrkref_dtl = invdtl.wrkref_dtl or cur_cas_tbl.wrkref = invsub.wrkref)
   join shipment
     on shipment.ship_id = shipment_line.ship_id
   join poldat
     on poldat.polcod = 'LC_PCK_LBL'
    and poldat.polvar = 'LABEL_PRINT'
    and poldat.polval = 'NOTTYP'
    and poldat.wh_id_tmpl = ord.wh_id
    and poldat.rtstr1 = ord.client_id
    and poldat.rtnum1 = 1
   left
   join ord_note
     on ord_note.ordnum = ord.ordnum
    and ord_note.client_id = ord.client_id
    and ord_note.wh_id = ord.wh_id
    and ord_note.nottyp = poldat.rtstr2
   join usr_uc_package_detail
     on usr_uc_package_detail.uc_pkg_id = invsub.uc_pkg_id
   left
   join poldat time_zone
     on time_zone.polcod = 'LC_PCK_LBL'
    and time_zone.polvar = 'PACK_TIME'
    and time_zone.polval = 'TIME_ZONE'
    and time_zone.wh_id_tmpl = ord.wh_id
    and time_zone.rtstr1 = ord.client_id
    and time_zone.rtnum1 = 1
  where shipment_line.ship_id = @ship_id
    and shipment_line.client_id = @client_id
    and shipment_line.wh_id = @wh_id
    and shipment_line.ordnum = @ordnum
    and invsub.subnum = @subnum
  group by @rpt_field_str01:raw,
        @rpt_field_str02:raw,
        @rpt_field_str03:raw,
        @rpt_field_str04:raw,
        @rpt_field_str05:raw,
        @rpt_field_str06:raw,
        @rpt_field_str07:raw,
        cast(from_tz(cast(to_date(ord_note.nottxt) AS TIMESTAMP), SESSIONTIMEZONE) AT TIME ZONE time_zone.rtstr2 AS DATE),
        @rpt_field_str10:raw,
        invdtl.prtnum,
        @rpt_field_str16:raw,
        @rpt_field_str17:raw,
        @rpt_field_str18:raw,
        @rpt_field_str19:raw,
        @rpt_field_str20:raw,
        @rpt_field_str21:raw,
        @rpt_field_str22:raw,
        @rpt_field_str23:raw,
        @rpt_field_str25:raw,
        @rpt_field_str27:raw,
        @rpt_field_str28:raw,
        @rpt_field_str29:raw,
        cur_cas_tbl.cur_cas,
        @rpt_field_str31:raw,
        @rpt_field_str32:raw,
        @rpt_field_str33:raw,
        usr_uc_package_detail.uc_grswgt]


]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-58487
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-10-22
    <p>
    This command is used to list lc packing sscc label details.
    </p>
]]>
</remarks>
</documentation>
</command>