<command>
  <name>process lc inventory details for weight check</name>
  <description>process lc inventory detail by subnum</description>
  <type>Local Syntax</type>
  <local-syntax>
    
<![CDATA[

/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables. */
[select sl.ordnum,
        sl.client_id
   from inventory_view iv
   join shipment_line sl
     on iv.ship_line_id = sl.ship_line_id
  where iv.subnum = @subnum
    and iv.wh_id = @wh_id
    and rownum = 1]
|
/* No existing MOCA list command, use select statement instead. */
[select distinct wrktyp,
        lodlvl
   from pckwrk_view
  where ordnum = @ordnum
    and client_id = @client_id] >> pckwrk_res
|
convert column results to string
 where resultset = @pckwrk_res
   and colnam = 'wrktyp'
   and separator = ','
|
publish data
 where wrktyp_list = @result_string
|
if (@wrktyp_list like '%K%')
{
    publish data
     where order_with_carton_flg = 1
}
|
if (rowcount(@pckwrk_res) = 1 and @order_with_carton_flg <> 1)
{
    publish data
     where order_full_case_flg = 1
}
|
if (@order_full_case_flg = 1)
{
    set return status
     where code = 4100003
}
else
{
    /* No existing MOCA list command, use select statement instead. */
    [select ctnflg
       from inventory_view
      WHERE subnum = @subnum
        and wh_id = @wh_id
        and rownum = 1]
    |
    if (@ctnflg = 0)
    {
        list lc weight details in full case
         where wh_id = @wh_id
           and subnum = @subnum
    }
    else if (@ctnflg = 1)
    {
        validate lc wrkref in carton
         where subnum = @subnum catch(-1403)
        |
        if (@? <> 0)
        {
            {
                list pick work
                 where subnum = @subnum
                   and ordnum = @ordnum
                   and wrktyp = 'K'
                |
                publish data
                 where ctn_wrkref = @wrkref
            }
            |
            execute server command
             where command = "change record where table = 'invsub' and subnum = '" || @subnum || "' and wrkref = '" || @ctn_wrkref || "'"
               and inline = 0
        }
        |
        list lc ip uom qty
         where subnum = @subnum catch(-1403)
        |
        if (@ip_qty > 0)
        {
            list lc weight details in inner pack
             where wh_id = @wh_id
               and subnum = @subnum
        }
        else
        {
            list lc weight details in carton
             where wh_id = @wh_id
               and subnum = @subnum
        }
    }
}


]]>    
  </local-syntax>
  <argument name="wh_id" required="yes" datatype="string">Warehouse ID</argument>
  <argument name="subnum" required="yes" datatype="string">Sub-LPN</argument>
  <documentation>
    <remarks>
      @author Kevin Wang
      @since 2025-10-15
      SWIFTLEX-57791
      process lc inventory detail by subnum
    </remarks>
  </documentation>
</command>
