<command>
<name>list lc ip uom qty</name>
<description>list lc ip uom qty</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables.
 */
[select sum(ip_qty) ip_qty
   from (select decode(prtftp_dtl.untqty, 0, 0, trunc(sum(iv.untqty) / prtftp_dtl.untqty)) ip_qty
           from inventory_view iv
           join prtftp_dtl
             on prtftp_dtl.prtnum = iv.prtnum
            and prtftp_dtl.ftpcod = iv.ftpcod
            and prtftp_dtl.prt_client_id = iv.prt_client_id
            and prtftp_dtl.wh_id = iv.wh_id
            and prtftp_dtl.uomcod = 'IP'
          where iv.subnum = @subnum
          group by prtftp_dtl.untqty)]




]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-57791
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-12-24
    <p>
    This command is used to list lc ip uom qty.
    </p>
]]>
</remarks>
</documentation>
</command>