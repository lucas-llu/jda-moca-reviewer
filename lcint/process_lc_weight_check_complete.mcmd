<command>
  <name>process lc weight check complete</name>
  <description>process lc weight check complete</description>
  <type>Local Syntax</type>
  <local-syntax>
    
<![CDATA[

get lc weight check data for complete
 where subnum = @subnum
   and wh_id = @wh_id catch(-1403)
|
if (@? = 0)
{
    list policies
     where polcod = 'LC_SSCC_NUM'
       and polvar = 'REMOVE_SSCC_PREFIX'
       and polval = 'INSTALL'
       and rtstr1 = @client_id
       and wh_id = nvl(@wh_id, @@wh_id)
       and rtnum1 = 1 catch(-1403)
    |
    if (@? = 0)
    {
        publish data
         where old_subnum = @subnum
           and new_subnum = substr(@old_subnum, 3)
        |
        validate key exists
         where table = 'invsub'
           and key = 'subnum'
           and subnum = @new_subnum catch(@?)
        |
        if (@? = 0)
        {
            set return status
             where status = 4100016
        }
        |
        change inventory identifier
         where lodlvl = 'S'
           and from_id = @old_subnum
           and to_id = @new_subnum
           and wh_id = @wh_id catch(@?)
        |
        publish data
         where subnum = nvl(@new_subnum, @old_subnum)
    }
    |
    if (@ctncod)
    {
        /* No existing MOCA list command, use select statement instead.
         * Retrieve data from some tables directly since there is no view for these tables. */
        [select ctnlen,
                ctnwid,
                ctnhgt,
                ctnwgt
           from ctnmst
          where ctncod = @ctncod
            and wh_id = @wh_id]
        |
        process usr package for outbound order
         where entity_type = 'INVSUB'
           and entity_key = @subnum
           and pkgtype = @ctncod
           and pkglen = @ctnlen
           and pkgwdt = @ctnwid
           and pkghgt = @ctnhgt
           and grswgt = to_number(@actual_weight) * 1000
           and netwgt = to_number(to_number(@actual_weight) * 1000 - to_number(@ctnwgt))
    }
    else
    {
        /* No existing MOCA list command, use select statement instead. */
        [select pv.caslen,
                pv.caswid,
                pv.cashgt,
                pv.netwgt
           from prtftp_view pv
           join inventory_view iv
             on iv.prtnum = pv.prtnum
            and iv.prt_client_id = pv.prt_client_id
            and iv.wh_id = pv.wh_id
            and iv.ftpcod = pv.ftpcod
          where iv.subnum = @subnum
            and iv.wh_id = @wh_id]
        |
        process usr package for outbound order
         where entity_type = 'INVSUB'
           and entity_key = @subnum
           and pkgtype = 'CASE'
           and pkglen = @caslen
           and pkgwdt = @caswid
           and pkghgt = @cashgt
           and grswgt = @actual_weight * 1000
           and netwgt = @netwgt
    }
    |
    process lc inventory details for weight check
     where subnum = @subnum
       and wh_id = @wh_id >> total_res
    |
    publish top rows
     where res = @total_res
       and count = 1
    |
    list lc picked untqty
     where subnum = @subnum
    |
    generate next number
     where numcod = 'usr_lc_history_id'
    |
    publish data
     where history_id = @nxtnum
    |
    create lc weight check history
     where history_id = @history_id
       and @+subnum
       and @+ordnum
       and @+ship_id
       and @+pick_usr_id
       and @+policy_condition
       and @+reason_code
       and wh_id = @wh_id
       and client_id = @client_id
       and carton_code = nvl(@ctncod, null)
       and system_mat_wgt = nvl(to_number(@total_weight_without_box), 0)
       and system_carton_wgt = nvl(to_number(@ctnwgt), 0)
       and total_system_wgt = nvl(to_number(@total_weight_without_box) + nvl(to_number(@ctnwgt), 0), 0)
       and weighting_scale_wgt = nvl(to_number(@actual_weight), 0)
       and item_count = nvl(to_number(@item_qty), 0)
       and station_pack_no = nvl(@devcod, @@devcod)
    |
    /* No existing MOCA list command, use select statement instead. */
    [select prtnum,
            srcloc,
            sum(untqty) untqty
       from inventory_pckwrk_view
      where subnum = @subnum
        and wh_id = @wh_id
      group by prtnum,
               srcloc]
    |
    generate next number
     where numcod = 'usr_lc_history_dtl_id'
    |
    publish data
     where history_dtl_id = @nxtnum
    |
    create lc weight check history detail
     where history_dtl_id = @history_dtl_id
       and history_id = @history_id
       and @+prtnum
       and @+untqty
       and wh_id = @wh_id
       and client_id = @client_id
       and srcloc = @srcloc
       and carton_code = nvl(@ctncod, null)
       and subnum = @subnum
       and ordnum = @ordnum
       and ship_id = @ship_id
       and @+pick_usr_id
       and @+policy_condition
       and @+reason_code
       and insert_datetime = sysdate
} >> res
else
{
    set return status
     where code = 4100005
}
|
list policies
 where polcod = 'LC_SSCC_NUM'
   and polvar = 'REMOVE_SSCC_PREFIX'
   and polval = 'INSTALL'
   and rtstr1 = @client_id
   and wh_id = nvl(@wh_id, @@wh_id)
   and rtnum1 = 1 catch(-1403)
|
if (@? = 0)
{
    publish data
     where subnum = substr(@subnum, 3)
}
|
update lc packing sscc label packing date
 where ordnum = @ordnum
   and wh_id = @wh_id
   and client_id = @client_id
|
execute server command
 where cmd = "list devices where devcod = nvl('" || @devcod || "', '" || @@devcod || "') and wh_id = '" || @wh_id || "'"
   and inline = 0 catch(-1403)
|
if (@? <> 0 or @lbl_prtadr is null)
{
    list lbl label formats
     where lblfmt = 'Lc-PackingSsccLabel' catch(-1403, 510)
    |
    publish data
     where lbl_prtadr = @def_printer
}
|
publish data
 where lbl_prtadr = @lbl_prtadr
|
generate label
 where locale_id = nvl(@locale_id, @@locale_id)
   and label_name = 'Lc-PackingSsccLabel'
   and client_id = @client_id
   and wh_id = @wh_id
   and ship_id = @ship_id
   and ordnum = @ordnum
   and subnum = @subnum catch(@?)
|
if (@? = 0)
{
    print lbl label operations label
     where filename = @outfile_name
       and prtadr = @lbl_prtadr catch(@?)
} >> res
|
generate next lpn
|
execute server command
 where cmd = "move inventory where subnum ='" || @subnum || "' and dstloc = '" || @dstloc || "' and wh_id = '" || @wh_id || "' and dstlod = '" || @nxtnum || "' and devcod = nvl('" || @devcod || "','" || @@devcod || "') and newdst = 1 "
   and inline = 0

]]>    
  </local-syntax>
  <argument name="wh_id" required="yes" datatype="string">Warehouse ID</argument>
  <argument name="subnum" required="yes" datatype="string">Sub-LPN</argument>
  <argument name="policy_condition" required="yes" datatype="string">Policy Condition</argument>
  <argument name="actual_weight" required="yes" datatype="float">Actual Weight</argument>
  <argument name="reason_code" datatype="string">Reason Code</argument>
  <argument name="ctncod" datatype="string">Carton Code</argument>
  
  <documentation>
    <remarks>
      @author Kevin Wang
      @since 2025-10-21
      SWIFTLEX-57791
      process lc weight check complete
    </remarks>
  </documentation>
</command>
