<command>
  <name>process lc sscc relabel merge dtl complete</name>
  <description>process lc sscc relabel merge dtl complete</description>
  <type>Local Syntax</type>
  <local-syntax>
    
<![CDATA[

{
    convert list
     where string = @total_dtlnum
       and separator = ','
       and type = 'L'
    |
    publish data
     where dtlnum_to_be_move = @retstr
    |
    /* no list command, use select instead. */
    [select stoloc dtlnum_in_stoloc
       from inventory_view
      where dtlnum = @dtlnum_to_be_move]
    |
    get translated inventory identifier
     where id = @invtid
       and wh_id = nvl(@wh_id, @@wh_id) catch(@?)
    |
    if (@? = 0)
    {
        if (@colnam = 'subnum')
        {
            publish data
             where subnum_exist_in_stoloc = @stoloc
        }
        else
        {
            set return status
             where code = 4100029
        }
    }
    |
    if (@subnum_exist_in_stoloc)
    {
        if (@subnum_exist_in_stoloc != @dtlnum_in_stoloc)
        {
            set return status
             where code = 4100030
        }
        else
        {
            execute server command
             where cmd = "move inventory where wh_id = '" || nvl(@wh_id, @@wh_id) || "' and srcdtl = '" || @dtlnum_to_be_move || "' and dstsub = '" || @invtid || "'"
               and inline = 0
        }
    }
    else
    {
        generate next lpn
        |
        publish data
         where new_lodnum = @nxtnum
        |
        execute server command
         where cmd = "move inventory where wh_id = '" || nvl(@wh_id, @@wh_id) || "' and srcdtl = '" || @dtlnum_to_be_move || "' and dstsub = '" || @invtid || "' and dstloc = '" || @dtlnum_in_stoloc || "' and newdst=1 and dstlod = '" || @new_lodnum || "'"
           and inline = 0
    }
} >> res
|
publish data
 where goto_seqnum = 10

]]>    
  </local-syntax>
  <argument name="wh_id" required="yes" datatype="string">Warehouse ID</argument>
  <documentation>
    <remarks>
      @author Kevin Wang
      @since 2026-04-01
      SWIFTLEX-67708
      The command is used to process lc sscc relabel merge dtl complete.
    </remarks>
  </documentation>
</command>
