<command>
<name>list lc picked untqty</name>
<description>list lc picked untqty</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables.
 */
[select sum(untqty) item_qty
   from inventory_view
  where subnum = @subnum]

]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-57791
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2026-02-24
    <p>
    This command is used to list lc picked untqty.
    </p>
]]>
</remarks>
</documentation>
</command>