<command>
<name>validate lc wrkref in carton</name>
<description>validate lc wrkref in carton</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables.
 */
[select 'X'
   from invsub
  where subnum = @subnum
    and wrkref is not null]


]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-57791
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2026-02-28
    <p>
    This command is used to validate lc order ready ordtyp.
    </p>
]]>
</remarks>
</documentation>
</command>