<command>
  <name>get lc weight check reason code</name>
  <description>get lc weight check reason code</description>
  <type>Local Syntax</type>
  <local-syntax>
    
<![CDATA[

list reason code groups
 where wh_id = @wh_id
   and reagrp = 'LC_WEIGHT_CHECK'
   and client_id = @client_id catch(@?)
|
if(@?=0)
{
  publish data
   where @+reacod_dsc
    and @+reacod
}

]]>    
  </local-syntax>
  <argument name="wh_id" required="yes" datatype="string">Warehouse ID</argument>
  <argument name="client_id" required="yes" datatype="string">Client ID</argument>
  <documentation>
    <remarks>
      @author Kevin Wang
      @since 2025-10-23
      SWIFTLEX-57791
      get lc weight check reason code
    </remarks>
  </documentation>
</command>
