        max(decode(polval, 'TABLE_FIELD_30', rtstr2, NULL)) rpt_field_str30,
        max(decode(polval, 'TABLE_FIELD_31', rtstr2, NULL)) rpt_field_str31,
        max(decode(polval, 'TABLE_FIELD_32', rtstr2, NULL)) rpt_field_str32,
        max(decode(polval, 'TABLE_FIELD_33', rtstr2, NULL)) rpt_field_str33
   from poldat_view
  where polcod = 'LC_PCK_LBL'
    and polvar in ('STATIC_FIELD', 'TABLE_FIELD')
    and wh_id = @wh_id
    and rtstr1 = @client_id]


]]>
</local-syntax>

