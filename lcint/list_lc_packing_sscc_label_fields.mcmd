<command>
<name>list lc packing sscc label fields</name>
<description>list lc packing sscc label fields</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables.
 */
[select max(decode(polval, 'STATIC_FIELD_01', rtstr2, NULL)) rpt_static_str01,
        max(decode(polval, 'STATIC_FIELD_02', rtstr2, NULL)) rpt_static_str02,
        max(decode(polval, 'STATIC_FIELD_03', rtstr2, NULL)) rpt_static_str03,
        max(decode(polval, 'STATIC_FIELD_04', rtstr2, NULL)) rpt_static_str04,
        max(decode(polval, 'STATIC_FIELD_05', rtstr2, NULL)) rpt_static_str05,
        max(decode(polval, 'STATIC_FIELD_06', rtstr2, NULL)) rpt_static_str06,
        max(decode(polval, 'STATIC_FIELD_07', rtstr2, NULL)) rpt_static_str07,
        max(decode(polval, 'STATIC_FIELD_08', rtstr2, NULL)) rpt_static_str08,
        max(decode(polval, 'STATIC_FIELD_09', rtstr2, NULL)) rpt_static_str09,
        max(decode(polval, 'STATIC_FIELD_10', rtstr2, NULL)) rpt_static_str10,
        max(decode(polval, 'STATIC_FIELD_11', rtstr2, NULL)) rpt_static_str11,
        max(decode(polval, 'STATIC_FIELD_12', rtstr2, NULL)) rpt_static_str12,
        max(decode(polval, 'STATIC_FIELD_13', rtstr2, NULL)) rpt_static_str13,
        max(decode(polval, 'STATIC_FIELD_14', rtstr2, NULL)) rpt_static_str14,
        max(decode(polval, 'STATIC_FIELD_15', rtstr2, NULL)) rpt_static_str15,
        max(decode(polval, 'STATIC_FIELD_16', rtstr2, NULL)) rpt_static_str16,
        max(decode(polval, 'STATIC_FIELD_17', rtstr2, NULL)) rpt_static_str17,
        max(decode(polval, 'STATIC_FIELD_18', rtstr2, NULL)) rpt_static_str18,
        max(decode(polval, 'STATIC_FIELD_19', rtstr2, NULL)) rpt_static_str19,
        max(decode(polval, 'STATIC_FIELD_20', rtstr2, NULL)) rpt_static_str20,
        max(decode(polval, 'STATIC_FIELD_21', rtstr2, NULL)) rpt_static_str21,
        max(decode(polval, 'STATIC_FIELD_22', rtstr2, NULL)) rpt_static_str22,
        max(decode(polval, 'TABLE_FIELD_01', rtstr2, NULL)) rpt_field_str01,
        max(decode(polval, 'TABLE_FIELD_02', rtstr2, NULL)) rpt_field_str02,
        max(decode(polval, 'TABLE_FIELD_03', rtstr2, NULL)) rpt_field_str03,
        max(decode(polval, 'TABLE_FIELD_04', rtstr2, NULL)) rpt_field_str04,
        max(decode(polval, 'TABLE_FIELD_05', rtstr2, NULL)) rpt_field_str05,
        max(decode(polval, 'TABLE_FIELD_06', rtstr2, NULL)) rpt_field_str06,
        max(decode(polval, 'TABLE_FIELD_07', rtstr2, NULL)) rpt_field_str07,
        max(decode(polval, 'TABLE_FIELD_08', rtstr2, NULL)) rpt_field_str08,
        max(decode(polval, 'TABLE_FIELD_09', rtstr2, NULL)) rpt_field_str09,
        max(decode(polval, 'TABLE_FIELD_10', rtstr2, NULL)) rpt_field_str10,
        max(decode(polval, 'TABLE_FIELD_11', rtstr2, NULL)) rpt_field_str11,
        max(decode(polval, 'TABLE_FIELD_12', rtstr2, NULL)) rpt_field_str12,
        max(decode(polval, 'TABLE_FIELD_13', rtstr2, NULL)) rpt_field_str13,
        max(decode(polval, 'TABLE_FIELD_14', rtstr2, NULL)) rpt_field_str14,
        max(decode(polval, 'TABLE_FIELD_15', rtstr2, NULL)) rpt_field_str15,
        max(decode(polval, 'TABLE_FIELD_16', rtstr2, NULL)) rpt_field_str16,
        max(decode(polval, 'TABLE_FIELD_17', rtstr2, NULL)) rpt_field_str17,
        max(decode(polval, 'TABLE_FIELD_18', rtstr2, NULL)) rpt_field_str18,
        max(decode(polval, 'TABLE_FIELD_19', rtstr2, NULL)) rpt_field_str19,
        max(decode(polval, 'TABLE_FIELD_20', rtstr2, NULL)) rpt_field_str20,
        max(decode(polval, 'TABLE_FIELD_21', rtstr2, NULL)) rpt_field_str21,
        max(decode(polval, 'TABLE_FIELD_22', rtstr2, NULL)) rpt_field_str22,
        max(decode(polval, 'TABLE_FIELD_23', rtstr2, NULL)) rpt_field_str23,
        max(decode(polval, 'TABLE_FIELD_24', rtstr2, NULL)) rpt_field_str24,
        max(decode(polval, 'TABLE_FIELD_25', rtstr2, NULL)) rpt_field_str25,
        max(decode(polval, 'TABLE_FIELD_26', rtstr2, NULL)) rpt_field_str26,
        max(decode(polval, 'TABLE_FIELD_27', rtstr2, NULL)) rpt_field_str27,
        max(decode(polval, 'TABLE_FIELD_28', rtstr2, NULL)) rpt_field_str28,
