<command>
  <name>process lc current serial number required prtnum</name>
  <description>process lc current serial number required prtnum</description>
  <type>Local Syntax</type>
  <local-syntax> 
<![CDATA[

{
    list lc serial package detail
     where subnum = @subnum
    |
    check serial number capture required
     where cur_frm_typ = 'OUTBOUND'
       and check_sernum = '1'
       and wrkref = @wrkref
       and wh_id = @wh_id
       and prtnum = @prtnum
       and prt_client_id = @prt_client_id catch(@?)
    |
    if (@process_typ = 'CAPTURE')
    {
        list lc current serial number capture detail
         where subnum = @subnum
           and prtnum = @prtnum catch(@?)
    }
    else
    {
        publish data
         where prtnum = '' 
    }
} >> serial_capture_detail
|
publish top rows
 where res = @serial_capture_detail
   and count = 1
|
list lc package quantity by subnum and prtnum
  where subnum = @subnum
    and prtnum = @prtnum
|
publish data
 where subnum = @subnum
   and prtnum = @prtnum
   and prt_client_id = @prt_client_id
   and total_qty = @pkg_qty - @total_qty
   and pkg_qty = @pkg_qty

]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-67708
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2026-03-31
    <p>
    This command is used to process lc current serial number required prtnum.
    </p>
]]>
</remarks>
</documentation>
</command>
