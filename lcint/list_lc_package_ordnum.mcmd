<command>
<name>list lc package ordnum</name>
<description>list lc package ordnum</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

if (@lodnum is null)
{
    hide stack variable
     where name = 'lodnum'
}
|
if (@subnum is null)
{
    hide stack variable
     where name = 'subnum'
}
|
if (@dtlnum is null)
{
    hide stack variable
     where name = 'dtlnum'
}
|
/* No existing MOCA list command, use select statement instead. */
[select ordnum
   from inventory_pckwrk_view
  where @+lodnum
    and @+subnum
    and @+dtlnum
    and rownum < 2]




]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-67708
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2026-04-09
    <p>
    This command is used to list lc package ordnum.
    </p>
]]>
</remarks>
</documentation>
</command>