<command>
<name>list lc usr stock level snapshot total stock detail</name>
<description>list lc usr stock level snapshot total stock detail</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables.
 * In sub select, the result will be limited by wh_id, prt_client_id, arecod.
 */
[select requestid,
        rundatetime,
        inventorysummarytype,
        wh_id,
        prtnum,
        prt_client_id,
        orgcod,
        revlvl,
        lotnum,
        sup_lotnum,
        invsts,
        supnum,
        mandte,
        expire_dte,
        hldflg,
        inv_attr_str1,
        inv_attr_str2,
        inv_attr_str3,
        inv_attr_str4,
        inv_attr_str5,
        inv_attr_str6,
        inv_attr_str7,
        inv_attr_str8,
        inv_attr_str9,
        inv_attr_str10,
        inv_attr_str11,
        inv_attr_str12,
        inv_attr_str13,
        inv_attr_str14,
        inv_attr_str15,
        inv_attr_str16,
        inv_attr_str17,
        inv_attr_str18,
        inv_attr_int1,
        inv_attr_int2,
        inv_attr_int3,
        inv_attr_int4,
        inv_attr_int5,
        inv_attr_flt1,
        inv_attr_flt2,
        inv_attr_flt3,
        inv_attr_dte1,
        inv_attr_dte2,
        sum(unitqty) as unitqty,
        sum(catch_qty) as catch_qty
   from (select @request_id requestid,
                current_date rundatetime,
                cast('TOTAL' as varchar2(20)) inventorysummarytype,
                c.wh_id wh_id,
                a.prtnum prtnum,
                a.prt_client_id prt_client_id,
                decode(@orgcod_flg, 0, ']**[',
                       case when a.orgcod = '----' then null
                            else a.orgcod
                       end) orgcod,
                decode(@revlvl_flg, 0, ']**[',
                       case when a.revlvl = '----' then null
                            else a.revlvl
                       end) revlvl,
                decode(@lotnum_flg, 0, ']**[',
                       case when a.lotnum = '----' then null
                            else a.lotnum
                       end) lotnum,
                a.sup_lotnum sup_lotnum,
                decode(@invsts_flg, 0, ']**[', a.invsts) invsts,
                a.supnum supnum,
                decode(@mandte_flg, 0, to_date('01 january 1900', 'dd month yyyy'), a.mandte) mandte,
                decode(@expire_dte_flg, 0, to_date('01 january 1900', 'dd month yyyy'), a.expire_dte) expire_dte,
                a.untqty unitqty,
                a.catch_qty catch_qty,
                cast(a.hld_flg as number(1, 0)) hldflg,
                decode(@inv_attr_str1_flg, 0, ']**[', a.inv_attr_str1) inv_attr_str1,
                decode(@inv_attr_str2_flg, 0, ']**[', a.inv_attr_str2) inv_attr_str2,
                decode(@inv_attr_str3_flg, 0, ']**[', a.inv_attr_str3) inv_attr_str3,
                decode(@inv_attr_str4_flg, 0, ']**[', a.inv_attr_str4) inv_attr_str4,
                decode(@inv_attr_str5_flg, 0, ']**[', a.inv_attr_str5) inv_attr_str5,
                decode(@inv_attr_str6_flg, 0, ']**[', a.inv_attr_str6) inv_attr_str6,
                decode(@inv_attr_str7_flg, 0, ']**[', a.inv_attr_str7) inv_attr_str7,
                decode(@inv_attr_str8_flg, 0, ']**[', a.inv_attr_str8) inv_attr_str8,
                decode(@inv_attr_str9_flg, 0, ']**[', a.inv_attr_str9) inv_attr_str9,
                decode(@inv_attr_str10_flg, 0, ']**[', a.inv_attr_str10) inv_attr_str10,
                decode(@inv_attr_str11_flg, 0, ']**[', a.inv_attr_str11) inv_attr_str11,
                decode(@inv_attr_str12_flg, 0, ']**[', a.inv_attr_str12) inv_attr_str12,
                decode(@inv_attr_str13_flg, 0, ']**[', a.inv_attr_str13) inv_attr_str13,
                decode(@inv_attr_str14_flg, 0, ']**[', a.inv_attr_str14) inv_attr_str14,
                decode(@inv_attr_str15_flg, 0, ']**[', a.inv_attr_str15) inv_attr_str15,
                decode(@inv_attr_str16_flg, 0, ']**[', a.inv_attr_str16) inv_attr_str16,
                decode(@inv_attr_str17_flg, 0, ']**[', a.inv_attr_str17) inv_attr_str17,
                decode(@inv_attr_str18_flg, 0, ']**[', a.inv_attr_str18) inv_attr_str18,
                a.inv_attr_int1 inv_attr_int1,
                a.inv_attr_int2 inv_attr_int2,
                a.inv_attr_int3 inv_attr_int3,
                a.inv_attr_int4 inv_attr_int4,
                a.inv_attr_int5 inv_attr_int5,
                a.inv_attr_flt1 inv_attr_flt1,
                a.inv_attr_flt2 inv_attr_flt2,
                a.inv_attr_flt3 inv_attr_flt3,
                decode(@inv_attr_dte1_flg, 0, to_date('01 january 1900', 'dd month yyyy'), a.inv_attr_dte1) inv_attr_dte1,
                decode(@inv_attr_dte2_flg, 0, to_date('01 january 1900', 'dd month yyyy'), a.inv_attr_dte2) inv_attr_dte2
           from invdtl a
           join invsub b
             on b.subnum = a.subnum
           join invlod c
             on c.lodnum = b.lodnum
           join locmst d
             on d.stoloc = c.stoloc
          where not exists(select 1
                             from locmst lm
                            where lm.arecod = d.arecod
                              and exists(select 1
                                           from loc_typ lt
                                          where lt.loc_typ_id = lm.loc_typ_id
                                            and (lt.fwiflg = '0' or lt.stgflg = 1 or lt.rcv_stgflg = 1 or lt.shpflg = '1' or lt.dispatch_flg = '1')
                                            and lt.wh_id = @wh_id))
            and c.wh_id = @wh_id
            and d.wh_id = @wh_id
            and a.prt_client_id = @prt_client_id)
  group by requestid,
        rundatetime,
        inventorysummarytype,
        wh_id,
        prtnum,
        prt_client_id,
        orgcod,
        revlvl,
        lotnum,
        sup_lotnum,
        invsts,
        supnum,
        mandte,
        expire_dte,
        hldflg,
        inv_attr_str1,
        inv_attr_str2,
        inv_attr_str3,
        inv_attr_str4,
        inv_attr_str5,
        inv_attr_str6,
        inv_attr_str7,
        inv_attr_str8,
        inv_attr_str9,
        inv_attr_str10,
        inv_attr_str11,
        inv_attr_str12,
        inv_attr_str13,
        inv_attr_str14,
        inv_attr_str15,
        inv_attr_str16,
        inv_attr_str17,
        inv_attr_str18,
        inv_attr_int1,
        inv_attr_int2,
        inv_attr_int3,
        inv_attr_int4,
        inv_attr_int5,
        inv_attr_flt1,
        inv_attr_flt2,
        inv_attr_flt3,
        inv_attr_dte1,
        inv_attr_dte2]


]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-58487
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-11-20
    <p>
    This command is used to list lc usr stock level snapshot total stock detail.
    </p>
]]>
</remarks>
</documentation>
</command>