<command>
<name>list lc wrkref pckuom</name>
<description>list lc wrkref pckuom</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables.
 */
[select pck_uom
   from pckwrk_view
  where wrkref = @wrkref
    and rownum < 2]




]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-63062
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2026-02-03
    <p>
    This command is used to list lc wrkref pckuom.
    </p>
]]>
</remarks>
</documentation>
</command>