<command>
  <name>process inventory move</name>
  <description>process inventory move</description>
  <type>Local Syntax</type>
  <local-syntax> 
<![CDATA[

list policies
 where polcod = 'LC_OUTBOUND'
   and polvar = 'CASE_PICK_SERIAL_CAPTURE'
   and polval = 'INSTALL'
   and rtstr1 = @prt_client_id
   and wh_id = nvl(@wh_id, @@wh_id)
   and rtnum1 = 1 catch(-1403)
|
if (@? = 0)
{
    list lc stoloc movement zone code
     where stoloc = @srcloc
       and wh_id = @wh_id catch(-1403)
    |
    publish data
     where src_mov_cod = @mov_zone_cod
    |
    list lc stoloc movement zone code
     where stoloc = @dstloc
       and wh_id = @wh_id catch(-1403)
    |
    publish data
     where dst_mov_cod = @mov_zone_cod
    |
    list policies
     where polcod = 'LC_OUTBOUND'
       and polvar = 'CASE_PICK_SERIAL_CAPTURE'
       and polval = 'CASE_MOVE_LOC'
       and rtstr1 = @src_mov_cod
       and rtstr2 = @dst_mov_cod
       and wh_id = nvl(@wh_id, @@wh_id)
       and rtnum1 = 1 catch(-1403)
    |
    if (@? = 0 and @srcqty = 1 and @srcref is not null and @phyflg = '1' and @uomcod = 'CS' and @dstsub is null)
    {
        /* No existing MOCA list command, use select statement instead.
         * Retrieve data from some tables directly since there is no view for these tables. 
         * Do not use list parts for better performance. */
        [select lodlvl,
                ser_lvl
           from prtmst
          where prtnum = @prtnum
            and wh_id_tmpl = @wh_id
            and prt_client_id = @prt_client_id
            and rownum = 1]
        |
        if (@lodlvl = 'S' and @ser_lvl = 'D')
        {
            list policies
             where polcod = 'LC_OUTBOUND'
               and polvar = 'CASE_PICK_SERIAL_CAPTURE'
               and polval = 'OPERATION'
               and rtstr1 = @actcod
               and rtstr2 = @oprcod
               and wh_id = nvl(@wh_id, @@wh_id)
               and rtnum1 = 1 catch(-1403)
            |
            if (@? = 0)
            {
                ^process inventory move
                 where srcloc = @srcloc
                   and srclod = @srclod
                   and srcsub = @srcsub
                   and srcdtl = @srcdtl
                   and prtnum = @prtnum
                   and prt_client_id = @prt_client_id
                   and rpl_invsts = @rpl_invsts
                   and srcqty = @srcqty
                   and src_catch_qty = @src_catch_qty
                   and dstloc = @dstloc
                   and dstlod = @dstlod
                   and dstsub = @srcsub || 'TEMP'
                   and newdst = @newdst
                   and untcas = @untcas
                   and untpak = @untpak
                   and srcref = @srcref
                   and usr_id = @usr_id
                   and devcod = @devcod
                   and actcod = @actcod
                   and oprcod = @oprcod
                   and sernum_outcap = @sernum_outcap
                   and sernum_sublmov = @sernum_sublmov
                   and wh_id = @wh_id
                   and sub_asset_typ = @sub_asset_typ
                   and asset_typ = @asset_typ
                   and ign_restrict = @ign_restrict
                   and lotnum = @lotnum
                   and uomcod = @uomcod
                   and ftpcod = @ftpcod
                   and can_sub_catch_flg = @can_sub_catch_flg
                   and spcind = @spcind
                   and delay_flg = @delay_flg
                   and pick_to_lvl = @pick_to_lvl
                   and reqnum = @reqnum
                   and phyflg = @phyflg
            }
            else
            {
                ^process inventory move
            }
        }
        else
        {
            ^process inventory move
        }
    }
    else
    {
        ^process inventory move
    }
}
else
{
    ^process inventory move
}

]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-60057
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-10-22
    <p>
    This command is used to process inventory move.
    </p>
]]>
</remarks>
</documentation>
</command>
