<command>
<name>update lc packing sscc label packing date</name>
<description>update lc packing sscc label packing date</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

list policies
 where polcod = 'LC_PCK_LBL'
   and polvar = 'LABEL_PRINT'
   and polval = 'NOTTYP'
   and wh_id = @wh_id
   and rtstr1 = @client_id
   and rtnum1 = 1 catch(-1403)
|
publish data
 where nottyp = @rtstr2
|
list order notes
 where ordnum = @ordnum
   and client_id = @client_id
   and wh_id = @wh_id
   and nottyp = @nottyp catch(-1403)
|
if (@? = -1403)
{
    create order note
     where ordnum = @ordnum
       and client_id = @client_id
       and wh_id = @wh_id
       and nottyp = @nottyp
       and nottxt = to_char(sysdate, 'YYYYMMDDHH24MISS')
       and notlin = '0001' catch(@?)
}
else
{
    change order note
     where ordnum = @ordnum
       and client_id = @client_id
       and wh_id = @wh_id
       and nottyp = @nottyp
       and nottxt = to_char(sysdate, 'YYYYMMDDHH24MISS')
       and notlin = '0001' catch(@?)
}


]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-58487
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-10-22
    <p>
    This command is used to update lc packing sscc label packing date.
    </p>
]]>
</remarks>
</documentation>
</command>