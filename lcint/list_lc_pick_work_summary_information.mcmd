<command>
<name>list lc pick work summary information</name>
<description>list lc pick work summary information</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables. 
 * The list_id is used to limit the result set of this sub select to be very small. */
[select tbl.srcloc,
        tbl.prtnum,
        tbl.ordnum,
        to_number(sum(case when pck_uom = 'CS' then 1
                           else 0
                      end)) as total_case,
        to_number(sum(case when pck_uom <> 'CS' then total_qty
                           else 0
                      end)) as total_each
   from (select wrkref,
                prtnum,
                srcloc,
                pck_uom,
                ordnum,
                list_seqnum,
                (pckqty - appqty) total_qty
           from pckwrk_view
          where list_id = @list_id
            and prtnum = @dspprt
            and srcloc = @dsploc
            and wrktyp <> 'K'
            and appqty < pckqty
         union
         select pv2.wrkref,
                pv2.prtnum,
                pv2.srcloc,
                pv2.pck_uom,
                pv2.ordnum,
                pv2.list_seqnum,
                (pv2.pckqty - pv2.appqty) total_qty
           from pckwrk_view pv1
           join pckwrk_view pv2
             on pv1.subnum = pv2.ctnnum
          where pv1.list_id = @list_id
            and pv2.prtnum = @dspprt
            and pv2.srcloc = @dsploc
            and pv1.wrktyp = 'K'
            and pv2.appqty < pv2.pckqty
          order by list_seqnum) tbl
  group by prtnum,
        srcloc,
        ordnum]



]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-63062
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2026-02-05
    <p>
    This command is used to list pick work summary information.
    </p>
]]>
</remarks>
</documentation>
</command>