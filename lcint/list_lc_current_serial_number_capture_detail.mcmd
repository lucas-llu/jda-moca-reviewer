<command>
  <name>list lc current serial number capture detail</name>
  <description>list lc current serial number capture detail</description>
  <type>Local Syntax</type>
  <local-syntax> 
<![CDATA[

/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables.
 */
[select subnum,
        prtnum,
        prt_client_id,
        total_qty
   from (select ipv.subnum,
                ipv.prtnum,
                ipv.prt_client_id,
                sum(ipv.untqty) total_qty
           from inventory_pckwrk_view ipv
          where ipv.subnum = @subnum
            and ipv.prtnum = @prtnum
            and not exists(select 'X'
                             from inv_ser_num
                            where inv_ser_num.invtid = ipv.dtlnum)
          group by ipv.subnum,
                ipv.prtnum,
                ipv.prt_client_id)
  where rownum = 1]

]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-67708
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2026-03-31
    <p>
    This command is used to list lc current serial number capture detail.
    </p>
]]>
</remarks>
</documentation>
</command>
