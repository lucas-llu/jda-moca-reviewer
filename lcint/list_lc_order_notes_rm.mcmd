<command>
<name>list lc order notes rm</name>
<description>list lc order notes rm</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

/* No existing MOCA list command, use select statement instead. 
 * Retrieve data from some tables directly since there is no view for these tables.
 */
[select distinct sl.ship_id,
        ord_note.client_id,
        ord_note.ordnum,
        ord_note.nottyp,
        ord_note.notlin,
        ord_note.wh_id,
        ord_note.nottxt,
        ord_note.edtflg,
        ord_note.u_version,
        ord_note.ins_dt,
        ord_note.last_upd_dt,
        ord_note.ins_user_id,
        ord_note.last_upd_user_id,
        ord_note.is_purged
   from ord_note
   left
   join shipment_line sl
     on sl.ordnum = ord_note.ordnum
    and sl.client_id = ord_note.client_id
    and sl.wh_id = ord_note.wh_id
    and sl.linsts != 'B'
  where ord_note.ordnum = @ordnum
    and ord_note.wh_id = @wh_id
    and ord_note.client_id = @client_id
    and @+sl.ship_id
  order by sl.ship_id,
        ord_note.wh_id,
        ord_note.client_id,
        ord_note.ordnum,
        ord_note.notlin]

]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-58488
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-10-14
    <p>
    This command is used to list lc order notes rm.
    </p>
]]>
</remarks>
</documentation>
</command>