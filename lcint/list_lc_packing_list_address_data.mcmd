<command>
<name>list lc packing list address data</name>
<description>list lc packing list address data</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

/*SQL select statement used as no standard list command or view is available*/
[select distinct fr_adrmst.adrnam fr_adrnam,
        fr_adrmst.adrln1 fr_adrln1,
        fr_adrmst.adrln2 fr_adrln2,
        fr_adrmst.adrln3 fr_adrln3,
        fr_adrmst.adrcty || ' ' || fr_adrmst.adrpsz fr_adrcty,
        fr_adrmst.ctry_name fr_ctry_name,
        st_adrmst.adrnam st_adrnam,
        st_adrmst.adrln1 st_adrln1,
        st_adrmst.adrln2 st_adrln2,
        st_adrmst.adrln3 st_adrln3,
        st_adrmst.adrcty st_adrcty,
        st_adrmst.adrstc || ' ' || st_adrmst.adrpsz st_adrstc,
        st_adrmst.ctry_name st_ctry_name,
        bt_adrmst.adrnam bt_adrnam,
        bt_adrmst.adrln1 bt_adrln1,
        bt_adrmst.adrln2 bt_adrln2,
        bt_adrmst.adrln3 bt_adrln3,
        bt_adrmst.adrcty bt_adrcty,
        bt_adrmst.adrstc || ' ' || bt_adrmst.adrpsz bt_adrstc,
        bt_adrmst.ctry_name bt_ctry_name,
        client_adrmst.adrnam client_adrnam,
        client_adrmst.adrln1 client_adrln1,
        client_adrmst.adrln2 client_adrln2,
        client_adrmst.adrln3 client_adrln3,
        client_adrmst.adrstc || ' ' || client_adrmst.adrpsz client_adrstc,
        client_adrmst.adrcty client_adrcty,
        client_adrmst.ctry_name client_ctry_name,
        car_adrmst.adrnam car_adrnam,
        car_adrmst.adrln1 car_adrln1,
        car_adrmst.adrln2 car_adrln2,
        car_adrmst.adrln3 car_adrln3,
        car_adrmst.adrstc || ' ' || car_adrmst.adrpsz car_adrstc,
        car_adrmst.adrcty car_adrcty,
        car_adrmst.ctry_name car_ctry_name,
        ord_note_03.nottxt last_name,
        TO_CHAR(shipment.stgdte, 'DD MON YYYY') stgdte,
        ord_note_01.nottxt || ' ' || ord_note_02.nottxt incoterm_txt,
        shipment.ship_id,
        ord.client_id,
        wh_adrmst.adrnam wh_adrnam,
        wh_adrmst.adrln1 wh_adrln1,
        wh_adrmst.adrln2 wh_adrln2,
        wh_adrmst.adrln3 wh_adrln3,
        wh_adrmst.adrcty || ' ' || wh_adrmst.adrpsz wh_adrcty
   from shipment_line
   join ord
     on ord.client_id = shipment_line.client_id
    and ord.ordnum = shipment_line.ordnum
    and ord.wh_id = shipment_line.wh_id
   join client
     on client.client_id = ord.client_id
   join wh
     on ord.wh_id = wh.wh_id
   left
   join adrmst wh_adrmst
     on wh_adrmst.adr_id = wh.adr_id
   left
   join adrmst fr_adrmst
     on fr_adrmst.adr_id = client.adr_id
   join adrmst st_adrmst
     on st_adrmst.adr_id = ord.st_adr_id
   join shipment
     on shipment.ship_id = shipment_line.ship_id
   left
   join carhdr
     on carhdr.carcod = shipment.carcod
   left
   join adrmst bt_adrmst
     on bt_adrmst.adr_id = ord.bt_adr_id
   left
   join adrmst client_adrmst
     on client_adrmst.adr_id = client.adr_id
   left
   join adrmst client_adrmst
     on client_adrmst.adr_id = client.adr_id
   left
   join adrmst car_adrmst
     on car_adrmst.adr_id = carhdr.adr_id
   left
   join ord_note ord_note_01
     on ord_note_01.client_id = ord.client_id
    and ord_note_01.ordnum = ord.ordnum
    and ord_note_01.wh_id = ord.wh_id
    and ord_note_01.nottyp = 'INCOTERM_01'
   left
   join ord_note ord_note_02
     on ord_note_02.client_id = ord.client_id
    and ord_note_02.ordnum = ord.ordnum
    and ord_note_02.wh_id = ord.wh_id
    and ord_note_02.nottyp = 'INCOTERM_02'
   left
   join ord_note ord_note_03
     on ord_note_03.client_id = ord.client_id
    and ord_note_03.ordnum = ord.ordnum
    and ord_note_03.wh_id = ord.wh_id
    and ord_note_03.nottyp = 'CR_MODE'
  where shipment_line.linsts != 'B'
    and shipment.ship_id = @ship_id
    and shipment.wh_id = @wh_id
    and shipment_line.ordnum = @ordnum]

]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-60323
    @author Reko/Lydia Luo
    @version 1.0.0
    @since 2025-11-18

    <p>
        This command is used to list packing list report address data.
    </p>
]]>
</remarks>

</documentation>
</command>