<command>
<name>validate lc packing sscc label fields</name>
<description>validate lc packing sscc label fields</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

do loop
 where iterations = 33
|
if (@i < 9)
{
    publish data
     where res_str = '@rpt_field_str0' || (@i + 1)
}
else
{
    publish data
     where res_str = '@rpt_field_str' || (@i + 1)
}
|
publish data
 where cmd = 'validate lc sql injection where lc_input =' || @res_str
|
execute server command
 where cmd = @cmd
|
if (@result = 0)
{
    set return status
     where status = 4100001
}


]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-58487
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-10-22
    <p>
    This command is used to validate lc packing sscc label fields.
    </p>
]]>
</remarks>
</documentation>
</command>