<command>
<name>list lc packing sscc label order note text</name>
<description>list lc packing sscc label order note text</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

validate lc packing sscc label fields
|
/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables.
 * Use poldat instead of poldat_view for better performance.
 * Use raw because MOCA logic requires literal substitution.
 * Fields has been validated sql injection in nottxt.
 * We do not place this complex SQL in a separate command because the business logic cannot separate this complex SQL from field validation logic.
 */
[select @result_string:raw
   from poldat
   join ord_note
     on ord_note.wh_id = poldat.wh_id_tmpl
    and ord_note.client_id = poldat.rtstr1
    and ord_note.nottyp = poldat.rtstr2
    and ord_note.ordnum = @ordnum
  where polcod = 'LC_PCK_LBL'
    and polvar = 'TABLE_FIELD'
    and wh_id_tmpl = @wh_id
    and rtstr1 = @client_id]


]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-58487
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-10-22
    <p>
    This command is used to list lc packing sscc label order note text.
    </p>
]]>
</remarks>
</documentation>
</command>