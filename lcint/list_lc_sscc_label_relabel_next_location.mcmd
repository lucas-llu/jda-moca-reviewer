<command>
  <name>list lc sscc label relabel next location</name>
  <description>list lc sscc label relabel next location</description>
  <type>Local Syntax</type>
  <local-syntax> 
<![CDATA[

/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables.
 * Use subnum and wh_id to limit the size of the sub query.
 */
[select nxt_loc_tbl.mov_sub,
        nxt_loc_tbl.dstloc
   from (select distinct ipv.subnum mov_sub,
                pckmov.seqnum,
                pckmov.stoloc dstloc
           from inventory_pckwrk_view ipv
           join pckmov
             on ipv.cmbcod = pckmov.cmbcod
          where ipv.subnum = @sscc_num
            and ipv.wh_id = @wh_id
          order by pckmov.seqnum desc) nxt_loc_tbl
  where rownum < 2]

]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-60987
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-10-22
    <p>
    This command is used to list lc sscc label relabel next location.
    </p>
]]>
</remarks>
</documentation>
</command>
