<command>
<name>get lc shipment bill to address rm</name>
<description>get lc shipment bill to address rm</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

/* No existing MOCA list command, use select statement instead. 
 * Retrieve data from some tables directly since there is no view for these tables.
 */
[select distinct adrmst.adr_id,
        adrmst.client_id,
        adrmst.host_ext_id,
        adrmst.adrnam,
        adrmst.adrtyp,
        adrmst.adrln1,
        adrmst.adrln2,
        adrmst.adrln3,
        adrmst.adrcty,
        adrmst.adrstc,
        adrmst.adrpsz,
        adrmst.ctry_name,
        adrmst.rgncod,
        adrmst.phnnum,
        adrmst.faxnum,
        adrmst.attn_name,
        adrmst.attn_tel,
        adrmst.cont_name,
        adrmst.cont_tel,
        adrmst.cont_title,
        adrmst.rsaflg,
        adrmst.temp_flg,
        adrmst.po_box_flg,
        adrmst.last_name,
        adrmst.first_name,
        adrmst.honorific,
        adrmst.usr_dsp,
        adrmst.adr_district,
        adrmst.web_adr,
        adrmst.email_adr,
        adrmst.pagnum,
        adrmst.locale_id,
        adrmst.pool_flg,
        adrmst.pool_rate_serv_nam,
        adrmst.ship_phnnum,
        adrmst.ship_faxnum,
        adrmst.ship_web_adr,
        adrmst.ship_email_adr,
        adrmst.ship_cont_name,
        adrmst.ship_cont_title,
        adrmst.ship_cont_tel,
        adrmst.ship_attn_name,
        adrmst.ship_attn_phnnum,
        adrmst.tim_zon_cd,
        adrmst.rqst_state_cod,
        adrmst.grp_nam,
        adrmst.latitude,
        adrmst.longitude,
        adrmst.gln,
        adrmst.cstms_site_typ,
        adrmst.cstms_tx_site,
        adrmst.is_purged,
        adrmst.uc_host_address,
        adrmst.uc_vat_number,
        ctry_mst.iso_2_ctry_name
   from adrmst
   left outer
   join ctry_mst
     on ctry_mst.ctry_name = adrmst.ctry_name
   join cstmst
     on cstmst.adr_id = adrmst.adr_id
   join ord
     on ord.btcust = cstmst.cstnum
    and ord.client_id = cstmst.client_id
   left
   join shipment_line
     on shipment_line.ordnum = ord.ordnum
    and shipment_line.client_id = ord.client_id
    and shipment_line.wh_id = ord.wh_id
    and shipment_line.linsts != 'B'
  where ord.ordnum = @ordnum
    and ord.wh_id = @wh_id
    and ord.client_id = @client_id]

]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-58488
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-10-14
    <p>
    This command is used to get lc shipment bill to address rm.
    </p>
]]>
</remarks>
</documentation>
</command>