<command>
<name>validate lc sscc relabel subnum</name>
<description>validate lc sscc relabel subnum</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

list lc package client id
 where subnum = @invtid catch(-1403)
|
if (@? <> 0)
{
    list policies
     where polcod = 'LC_RELABEL'
       and polvar = 'MERGE_DETAILS'
       and polval = 'INSTALL'
       and wh_id = nvl(@wh_id, @@wh_id)
       and rtnum1 = 1
       and rownum = 1 catch(-1403)
    |
    if (@? = 0)
    {
        get translated inventory identifier
         where id = @invtid
           and wh_id = nvl(@wh_id, @@wh_id) catch(@?)
        |
        if (@? = 0)
        {
            set return status
             where code = 11479
        }
        else
        {
            publish data
             where subnum_last_four_char = substr(@invtid, -4)
            |
            if (@subnum_last_four_char = 'TEMP')
            {
                set return status
                 where code = 4100026
            }
        }
    }
    else
    {
        set return status
         where status = 4100006
    }
}
else
{
    list lc sscc relabel pick method
     where invtid = @invtid
    |
    list policies
     where polcod = 'LC_RELABEL'
       and polvar = 'SSCC_LABEL'
       and polval = 'PCK_MTHD'
       and rtstr1 = @client_id
       and rtstr2 = @pck_mthd_nam
       and wh_id = nvl(@wh_id, @@wh_id)
       and rtnum1 = 1
       and rownum = 1 catch(-1403)
    |
    if (@? <> 0)
    {
        set return status
         where status = 4100007
    }
    |
    list lc package ordnum
     where subnum = @subnum
    |
    get lc order qty and picked qty
     where ordnum = @ordnum
       and wh_id = nvl(@wh_id, @@wh_id)
       and client_id = @client_id
    |
    if (@total_appqty != @total_pckqty)
    {
        set return status
         where code = 4100024
    };

    /* validate if all serial number captured */
    process lc current serial number required prtnum
     where subnum = @subnum
    |
    if (@prtnum)
    {
        set return status
         where code = 4100025
    };
    
    validate lc sscc relabel movement zone
     where client_id = @client_id
       and id = @invtid
       and wh_id = nvl(@wh_id, @@wh_id)
}

]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-60987
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-10-22
    <p>
    This command is used to validate lc sscc relabel subnum.
    </p>
]]>
</remarks>
</documentation>
</command>