<command>
  <name>add usr stock level snapshot total stock</name>
  <description>Add data to snapshot for total stock in warehouse</description>
  <type>Local Syntax</type>
  <local-syntax>
<![CDATA[

list policies
 where polcod = 'LC_STOCK_LEVEL'
   and polvar = 'TOTAL_STOCK'
   and polval = 'EXCLUD_STGED'
   and rtstr1 = @prt_client_id
   and wh_id = nvl(@wh_id, @@wh_id)
   and rtnum1 = 1 catch(-1403)
|
if (@? = 0)
{
    validate stack variable not null
     where name = 'wh_id'
    |
    validate stack variable not null
     where name = 'prt_client_id'
    |
    validate stack variable not null
     where name = 'request_id'
    |
    get usr group actions
     where use_case = 'stock level message includes items total stock'
       and use_case_type = 'MOCA'
       and wh_id = @wh_id
       and prt_client_id = @prt_client_id
    |
    if (@action = 'NO')
    {
        /* config actions determine total stock to be reported */
        publish data
         where success = '1'
    }
    else
    {
        /* avoid corrupting record creation later on */
        hide stack variable
         where name = 'id'
        |
        validate key exists
         where table = 'usr_uc_stock_snapshot'
           and key = 'requestid,inventorysummarytype'
           and requestid = @request_id
           and inventorysummarytype = 'TOTAL' catch(@?)
        |
        if (@? = 0)
        {
            set return status
             where status = 2000
               and errnum = '2000'
               and reasonid = 'snapshot for total stock in warehouse was already created for request_id ' || @request_id
        }
        |
        /* No existing MOCA list command, use select statement instead.
         * Retrieve data from some tables directly since there is no view for these tables.
         */
        [select *
           from usr_uc_stock_level_aggregation
          where @+wh_id
            and @+prt_client_id
            and disabled = 0
            and inventorysummarytype = 'TOTAL'] catch(-1403)
        |
        hide stack variable
         where name = 'id'
        |
        list lc usr stock level snapshot total stock detail catch(-1403)
        |
        if (@? = 0)
        {
            create record
             where table_name = 'usr_uc_stock_snapshot'
        };
        publish data
         where success = '1'
    }
}
else
{
    ^add usr stock level snapshot total stock
}

]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-58487
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2026-01-26
    <p>
    This command is used to add usr stock level snapshot total stock.
    </p>
]]>
</remarks>
</documentation>
</command>

