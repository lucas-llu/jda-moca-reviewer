<command>
<name>validate lc package id prefix</name>
<description>validate lc package id prefix</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

{
    list policies
     where polcod = 'LC_SSCC_NUM'
       and polvar = 'TOTAL_LENGTH_VALIDATION'
       and polval = 'INSTALL'
       and rtstr1 = @client_id
       and rtnum1 = 1
       and wh_id = nvl(@wh_id, @@wh_id) catch(-1403)
    |
    if (@? = 0)
    {
        list policies
         where polcod = 'LC_SSCC_NUM'
           and polvar = 'TOTAL_LENGTH'
           and polval = 'LENGTH'
           and rtstr1 = @client_id
           and rtnum1 = len(@subnum)
           and wh_id = nvl(@wh_id, @@wh_id) catch(-1403)
        |
        if (@? <> 0)
        {
            set return status
             where status = 4100009
        }
    }
}
|
{
    list policies
     where polcod = 'LC_SSCC_NUM'
       and polvar = 'DIGIT_NUM_VALIDATION'
       and polval = 'INSTALL'
       and rtstr1 = @client_id
       and rtnum1 = 1
       and wh_id = nvl(@wh_id, @@wh_id) catch(-1403)
    |
    if (@? = 0)
    {
        publish data
         where prefix_len = @rtstr2
        |
        list policies
         where polcod = 'LC_SSCC_NUM'
           and polvar = 'DIGIT_NUM'
           and polval = 'NUMBER'
           and rtstr1 = @client_id
           and rtstr2 = substr(@sscc_num, 3, @prefix_len)
           and wh_id = nvl(@wh_id, @@wh_id) catch(-1403)
        |
        if (@? <> 0)
        {
            set return status
             where status = 4100010
        }
    }
}
|
{
    list policies
     where polcod = 'LC_CARTON'
       and polvar = 'CTNNUM_VALIDATION'
       and polval = 'INSTALL'
       and wh_id = nvl(@wh_id, @@wh_id)
       and rtstr1 = @client_id
       and rtnum1 = 1 catch(-1403)
    |
    if (@? = 0)
    {
        if (@carton <> substr(@subnum, 1, len(@carton)))
        {
            set return status
             where status = 4100014
        }
        else
        {
            publish data
             where new_carton_number = substr(@subnum, len(@carton) + 1)
               and new_carton_start_position = len(@carton) + 1
        }
    }
    |
    publish data
     where new_carton_number = @new_carton_number
       and new_carton_start_position = @new_carton_start_position
}
|
{
    list policies
     where polcod = 'LC_CARTON_PICK'
       and polvar = 'SKIP_CARTON_VALIDATION'
       and polval = 'INSTALL'
       and wh_id = nvl(@wh_id, @@wh_id)
       and rtstr1 = @client_id
       and rtnum1 = 1 catch(-1403)
    |
    if (@? = 0)
    {
        list lc carton ready to complete for pick enhancement
         where subnum = @subnum
           and new_carton_start_position = @new_carton_start_position catch(@?) >>carton_complete_res
        |
        if (rowcount(@carton_complete_res) > 0)
        {
            set return status
             where status = 4100013
               and ctnnum = @subnum
        }
    }
}

]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-67709
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2026-04-09
    <p>
    This command is used to validate lc package id prefix.
    </p>
]]>
</remarks>
</documentation>
</command>