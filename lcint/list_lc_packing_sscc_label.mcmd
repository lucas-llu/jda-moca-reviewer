<command>
<name>list lc packing sscc label</name>
<description>list lc packing sscc label</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

list lc packing sscc label fields
 where wh_id = @wh_id
   and client_id = @client_id
|
list lc packing sscc label order note fields >> note_field_res
|
if (rowcount(@note_field_res) > 0)
{
    {
        publish data combination
         where @+note_field_res
        |
        publish data
         where field_name = 'TABLE_FIELD_' || substr(@order_note_fields, 15)
           and table_field_name = "max(decode(polval," || '''' || @field_name || "'" || ", nottxt, '')) as " || @field_name
           and rpt_name = substr(@order_note_fields, 2)
           and rpt_table_field_name = "null " || @rpt_name
    } >> field_name_res
    |
    convert column results to string
     where res = @field_name_res
       and column = 'table_field_name'
    |
    list lc packing sscc label order note text
    |
    convert column results to string
     where res = @field_name_res
       and column = 'rpt_table_field_name'
    |
    list lc packing sscc label ignore rpt fields
    |
    publish data
     where rpt_field_str01 = decode(@rpt_field_str01, null, 'null', 'wh_adrmst.' || @rpt_field_str01)
       and rpt_field_str02 = decode(@rpt_field_str02, null, 'null', 'wh_adrmst.' || @rpt_field_str02)
       and rpt_field_str03 = decode(@rpt_field_str03, null, 'null', 'wh_adrmst.' || @rpt_field_str03)
       and rpt_field_str04 = decode(@rpt_field_str04, null, 'null', 'wh_adrmst.' || @rpt_field_str04)
       and rpt_field_str05 = decode(@rpt_field_str05, null, 'null', 'wh_adrmst.' || @rpt_field_str05)
       and rpt_field_str06 = decode(@rpt_field_str06, null, 'null', @rpt_field_str06)
       and rpt_field_str07 = decode(@rpt_field_str07, null, 'null', @rpt_field_str07)
       and rpt_field_str08 = decode(@rpt_field_str08, null, 'null', @rpt_field_str08)
       and rpt_field_str09 = decode(@rpt_field_str09, null, 'null', @rpt_field_str09)
       and rpt_field_str10 = decode(@rpt_field_str10, null, 'null', @rpt_field_str10)
       and rpt_field_str11 = decode(@rpt_field_str11, null, 'null', @rpt_field_str11)
       and rpt_field_str12 = decode(@rpt_field_str12, null, 'null', @rpt_field_str12)
       and rpt_field_str13 = decode(@rpt_field_str13, null, 'null', @rpt_field_str13)
       and rpt_field_str14 = decode(@rpt_field_str14, null, 'null', @rpt_field_str14)
       and rpt_field_str15 = decode(@rpt_field_str15, null, 'null', @rpt_field_str15)
       and rpt_field_str16 = decode(@rpt_field_str16, null, 'null', 'sf_adrmst.' || @rpt_field_str16)
       and rpt_field_str17 = decode(@rpt_field_str17, null, 'null', 'sf_adrmst.' || @rpt_field_str17)
       and rpt_field_str18 = decode(@rpt_field_str18, null, 'null', 'sf_adrmst.' || @rpt_field_str18)
       and rpt_field_str19 = decode(@rpt_field_str19, null, 'null', 'sf_adrmst.' || @rpt_field_str19)
       and rpt_field_str20 = decode(@rpt_field_str20, null, 'null', 'sf_adrmst.' || substr(@rpt_field_str20, 1, instr(@rpt_field_str20, '||') - 1) || ' || ' || 'sf_adrmst.' || substr(@rpt_field_str20, instr(@rpt_field_str20, '|') + 2))
       and rpt_field_str21 = decode(@rpt_field_str21, null, 'null', 'sf_adrmst.' || @rpt_field_str21)
       and rpt_field_str22 = decode(@rpt_field_str22, null, 'null', @rpt_field_str22)
       and rpt_field_str23 = decode(@rpt_field_str23, null, 'null', @rpt_field_str23)
       and rpt_field_str24 = decode(@rpt_field_str24, null, 'null', @rpt_field_str24)
       and rpt_field_str25 = decode(@rpt_field_str25, null, 'null', @rpt_field_str25)
       and rpt_field_str26 = decode(@rpt_field_str26, null, 'null', @rpt_field_str26)
       and rpt_field_str27 = decode(@rpt_field_str27, null, 'null', @rpt_field_str27)
       and rpt_field_str28 = decode(@rpt_field_str28, null, 'null', @rpt_field_str28)
       and rpt_field_str29 = decode(@rpt_field_str29, null, 'null', @rpt_field_str29)
       and rpt_field_str30 = decode(@rpt_field_str30, null, 'null', @rpt_field_str30)
       and rpt_field_str31 = decode(@rpt_field_str31, null, 'null', @rpt_field_str31)
       and rpt_field_str32 = decode(@rpt_field_str32, null, 'null', @rpt_field_str32)
       and rpt_field_str33 = decode(@rpt_field_str33, null, 'null', @rpt_field_str33)
       and table_field_01 = @table_field_01
       and table_field_02 = @table_field_02
       and table_field_03 = @table_field_03
       and table_field_04 = @table_field_04
       and table_field_05 = @table_field_05
       and table_field_06 = @table_field_06
       and table_field_07 = @table_field_07
       and table_field_08 = @table_field_08
       and table_field_09 = @table_field_09
       and table_field_10 = @table_field_10
       and table_field_11 = @table_field_11
       and table_field_12 = @table_field_12
       and table_field_13 = @table_field_13
       and table_field_14 = @table_field_14
       and table_field_15 = @table_field_15
       and table_field_16 = @table_field_16
       and table_field_17 = @table_field_17
       and table_field_18 = @table_field_18
       and table_field_19 = @table_field_19
       and table_field_20 = @table_field_20
       and table_field_21 = @table_field_21
       and table_field_22 = @table_field_22
       and table_field_23 = @table_field_23
       and table_field_24 = @table_field_24
       and table_field_25 = @table_field_25
       and table_field_26 = @table_field_26
       and table_field_27 = @table_field_27
       and table_field_28 = @table_field_28
       and table_field_29 = @table_field_29
       and table_field_30 = @table_field_30
       and table_field_31 = @table_field_31
       and table_field_32 = @table_field_32
       and table_field_33 = @table_field_33
}
else
{
    publish data
     where rpt_field_str01 = decode(@rpt_field_str01, null, 'null', 'wh_adrmst.' || @rpt_field_str01)
       and rpt_field_str02 = decode(@rpt_field_str02, null, 'null', 'wh_adrmst.' || @rpt_field_str02)
       and rpt_field_str03 = decode(@rpt_field_str03, null, 'null', 'wh_adrmst.' || @rpt_field_str03)
       and rpt_field_str04 = decode(@rpt_field_str04, null, 'null', 'wh_adrmst.' || @rpt_field_str04)
       and rpt_field_str05 = decode(@rpt_field_str05, null, 'null', 'wh_adrmst.' || @rpt_field_str05)
       and rpt_field_str06 = decode(@rpt_field_str06, null, 'null', @rpt_field_str06)
       and rpt_field_str07 = decode(@rpt_field_str07, null, 'null', @rpt_field_str07)
       and rpt_field_str08 = decode(@rpt_field_str08, null, 'null', @rpt_field_str08)
       and rpt_field_str09 = decode(@rpt_field_str09, null, 'null', @rpt_field_str09)
       and rpt_field_str10 = decode(@rpt_field_str10, null, 'null', @rpt_field_str10)
       and rpt_field_str11 = decode(@rpt_field_str11, null, 'null', @rpt_field_str11)
       and rpt_field_str12 = decode(@rpt_field_str12, null, 'null', @rpt_field_str12)
       and rpt_field_str13 = decode(@rpt_field_str13, null, 'null', @rpt_field_str13)
       and rpt_field_str14 = decode(@rpt_field_str14, null, 'null', @rpt_field_str14)
       and rpt_field_str15 = decode(@rpt_field_str15, null, 'null', @rpt_field_str15)
       and rpt_field_str16 = decode(@rpt_field_str16, null, 'null', 'sf_adrmst.' || @rpt_field_str16)
       and rpt_field_str17 = decode(@rpt_field_str17, null, 'null', 'sf_adrmst.' || @rpt_field_str17)
       and rpt_field_str18 = decode(@rpt_field_str18, null, 'null', 'sf_adrmst.' || @rpt_field_str18)
       and rpt_field_str19 = decode(@rpt_field_str19, null, 'null', 'sf_adrmst.' || @rpt_field_str19)
       and rpt_field_str20 = decode(@rpt_field_str20, null, 'null', 'sf_adrmst.' || substr(@rpt_field_str20, 1, instr(@rpt_field_str20, '||') - 1) || ' || ' || 'sf_adrmst.' || substr(@rpt_field_str20, instr(@rpt_field_str20, '|') + 2))
       and rpt_field_str21 = decode(@rpt_field_str21, null, 'null', 'sf_adrmst.' || @rpt_field_str21)
       and rpt_field_str22 = decode(@rpt_field_str22, null, 'null', @rpt_field_str22)
       and rpt_field_str23 = decode(@rpt_field_str23, null, 'null', @rpt_field_str23)
       and rpt_field_str24 = decode(@rpt_field_str24, null, 'null', @rpt_field_str24)
       and rpt_field_str25 = decode(@rpt_field_str25, null, 'null', @rpt_field_str25)
       and rpt_field_str26 = decode(@rpt_field_str26, null, 'null', @rpt_field_str26)
       and rpt_field_str27 = decode(@rpt_field_str27, null, 'null', @rpt_field_str27)
       and rpt_field_str28 = decode(@rpt_field_str28, null, 'null', @rpt_field_str28)
       and rpt_field_str29 = decode(@rpt_field_str29, null, 'null', @rpt_field_str29)
       and rpt_field_str30 = decode(@rpt_field_str30, null, 'null', @rpt_field_str30)
       and rpt_field_str31 = decode(@rpt_field_str31, null, 'null', @rpt_field_str31)
       and rpt_field_str32 = decode(@rpt_field_str32, null, 'null', @rpt_field_str32)
       and rpt_field_str33 = decode(@rpt_field_str33, null, 'null', @rpt_field_str33)
}
|
{
    list lc packing sscc label details
     where wh_id = @wh_id
       and ordnum = @ordnum
       and client_id = @client_id
       and ship_id = @ship_id
       and subnum = @subnum catch(-1403)
    |
    if (@? <> 0)
    {
        list lc packing sscc label details hist
         where wh_id = @wh_id
           and ordnum = @ordnum
           and client_id = @client_id
           and ship_id = @ship_id
           and subnum = @subnum
    }
    |
    publish data
     where rpt_field01 = @rpt_field01
       and rpt_field02 = @rpt_field02
       and rpt_field03 = @rpt_field03
       and rpt_field04 = @rpt_field04
       and rpt_field05 = @rpt_field05
       and rpt_field06 = @rpt_field06
       and rpt_field07 = @rpt_field07
       and pack_dt = @pack_dt
       and client_id = @client_id
       and prtnum = @prtnum
       and untqty = @untqty
       and rpt_field16 = @rpt_field16
       and rpt_field17 = @rpt_field17
       and rpt_field18 = @rpt_field18
       and rpt_field19 = @rpt_field19
       and rpt_field20 = @rpt_field20
       and rpt_field21 = @rpt_field21
       and rpt_field22 = @rpt_field22
       and rpt_field23 = @rpt_field23
       and rpt_field25 = @rpt_field25
       and rpt_field27 = @rpt_field27
       and rpt_field28 = @rpt_field28
       and rpt_field29 = @rpt_field29
       and curcas = @curcas
       and rpt_field31 = @rpt_field31
       and rpt_field32 = @rpt_field32
       and rpt_field33 = @rpt_field33
       and total_wgt = @total_wgt
} >> res
|
/* No existing MOCA list command, use select statement instead. */
[select count(distinct aiv.subnum) totcas
   from all_inventory_view aiv
   join shipment_line sl
     on aiv.ship_line_id = sl.ship_line_id
  where sl.ordnum = @ordnum
    and sl.wh_id = @wh_id
    and sl.client_id = @client_id]
|
publish data
 where total_rownum = rowcount(@res)
|
[select ceil(@total_rownum / 10) loop_count
   from dual]
|
do loop
 where count = @loop_count
|
publish rows
 where res = @res
   and rows = 10
   and start = @i * 10 >> res1
|
convert column to multicolumn
 where res = @res1
   and colnam = 'prtnum'
   and column_count = 10
|
convert column to multicolumn
 where res = @res1
   and colnam = 'untqty'
   and column_count = 10
|
publish top rows
 where res = @res
   and count = 1
|
filter data
 where moca_filter_level = 1
   and rpt_static01 = @rpt_static_str01
   and rpt_static02 = @rpt_static_str02
   and rpt_static03 = @rpt_static_str03
   and rpt_static04 = @rpt_static_str04
   and rpt_static05 = @rpt_static_str05
   and rpt_static06 = @rpt_static_str06
   and rpt_static07 = @rpt_static_str07
   and rpt_static08 = @rpt_static_str08
   and rpt_static09 = @rpt_static_str09
   and rpt_static10 = @rpt_static_str10
   and rpt_static11 = @rpt_static_str11
   and rpt_static12 = @rpt_static_str12
   and rpt_static13 = @rpt_static_str13
   and rpt_static14 = @rpt_static_str14
   and rpt_static15 = @rpt_static_str15
   and rpt_static16 = @rpt_static_str16
   and rpt_static17 = @rpt_static_str17
   and rpt_static18 = @rpt_static_str18
   and rpt_static19 = @rpt_static_str19
   and rpt_static20 = @rpt_static_str20
   and rpt_static21 = @rpt_static_str21
   and rpt_static22 = @rpt_static_str22
   and totcas = @totcas
   and rpt_field01 = nvl(@rpt_field01, @table_field_01)
   and rpt_field03 = nvl(@rpt_field03, @table_field_03)
   and rpt_field04 = nvl(@rpt_field04, @table_field_04)
   and rpt_field05 = nvl(@rpt_field05, @table_field_05)
   and rpt_field06 = nvl(@rpt_field06, @table_field_06)
   and rpt_field07 = nvl(@rpt_field07, @table_field_07)
   and rpt_field08 = to_char(@pack_dt, 'DD.MM.YYYY')
   and rpt_field09 = to_char(@pack_dt, 'HH24:MI:SS')
   and rpt_field10 = nvl(@rpt_field10, trim(substr(@client_id, -4)))
   and rpt_field11 = @prtnum
   and rpt_field12 = @untqty
   and rpt_field13 = nvl(@rpt_field13, @table_field_13)
   and rpt_field14 = nvl(@rpt_field14, @table_field_14)
   and rpt_field15 = @total_wgt || ' KG'
   and rpt_field16 = nvl(@rpt_field16, @table_field_16)
   and rpt_field17 = nvl(@rpt_field17, @table_field_17)
   and rpt_field18 = nvl(@rpt_field18, @table_field_18)
   and rpt_field19 = nvl(@rpt_field19, @table_field_19)
   and rpt_field20 = nvl(@rpt_field20, @table_field_20)
   and rpt_field21 = nvl(@rpt_field21, @table_field_21)
   and rpt_field22 = nvl(@rpt_field22, @table_field_22)
   and rpt_field23 = nvl(@rpt_field23, @table_field_23)
   and rpt_field24 = nvl(@rpt_field24, @table_field_24)
   and rpt_field25 = nvl(@rpt_field25, @table_field_25)
   and rpt_field26 = nvl(@rpt_field26, @table_field_26)
   and rpt_field27 = nvl(@rpt_field27, @table_field_27)
   and rpt_field28 = nvl(@rpt_field28, @table_field_28)
   and rpt_field29 = nvl(@rpt_field29, @table_field_29)
   and rpt_field30 = nvl(@rpt_field30, @table_field_30)
   and rpt_field31 = nvl(@rpt_field31, @table_field_31)
   and rpt_field32 = nvl(@rpt_field32, @table_field_32)
   and rpt_field33 = nvl(@rpt_field33, @table_field_33)
   and prtnum_0 = @prtnum_0
   and prtnum_1 = @prtnum_1
   and prtnum_2 = @prtnum_2
   and prtnum_3 = @prtnum_3
   and prtnum_4 = @prtnum_4
   and prtnum_5 = @prtnum_5
   and prtnum_6 = @prtnum_6
   and prtnum_7 = @prtnum_7
   and prtnum_8 = @prtnum_8
   and prtnum_9 = @prtnum_9
   and untqty_0 = decode(@untqty_0, null, null, @untqty_0 || ' PCE')
   and untqty_1 = decode(@untqty_1, null, null, @untqty_1 || ' PCE')
   and untqty_2 = decode(@untqty_2, null, null, @untqty_2 || ' PCE')
   and untqty_3 = decode(@untqty_3, null, null, @untqty_3 || ' PCE')
   and untqty_4 = decode(@untqty_4, null, null, @untqty_4 || ' PCE')
   and untqty_5 = decode(@untqty_5, null, null, @untqty_5 || ' PCE')
   and untqty_6 = decode(@untqty_6, null, null, @untqty_6 || ' PCE')
   and untqty_7 = decode(@untqty_7, null, null, @untqty_7 || ' PCE')
   and untqty_8 = decode(@untqty_8, null, null, @untqty_8 || ' PCE')
   and untqty_9 = decode(@untqty_9, null, null, @untqty_9 || ' PCE')


]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-58487
