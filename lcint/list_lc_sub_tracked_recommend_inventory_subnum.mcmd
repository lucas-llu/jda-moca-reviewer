<command>
<name>list lc sub tracked recommend inventory subnum</name>
<description>list lc sub tracked recommend inventory subnum</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

publish data
 where wh_id = @wh_id
   and wrkref = @wrkref
|
list lc wrkref client id
 where wrkref = @wrkref catch(-1403)
|
list policies
 where polcod = 'LC_PICK'
   and polvar = 'PICK_REMOMMEND'
   and polval = 'INSTALL'
   and rtstr1 = @client_id
   and wh_id = @wh_id
   and rtnum1 = 1 catch(-1403)
|
if (@? = 0)
{
    list lc sub tracked inventory case pick qty
    where wrkref = @wrkref
    |
    list lc sub tracked inventory subnum
     where wrkref = @wrkref catch(-1403)
    |
    if(@cas_qty = 0 and @? = -1403)
    {
        list lc sub tracked inventory subnum
       where wrkref = @wrkref and recheck_flg = 1 catch(-1403)
    }
    |
    publish data
     where res_subnum = @subnum || " " || @untqty || " " || @stoloc || " " || @invsts || " " || @inv_attr_str1 || " " || @fifdte
}
else
{
    get best date controlled inventory
     where wh_id = @wh_id
       and wrkref = @wrkref
}


]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-63062
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-10-22
    <p>
    This command is used to list lc sub tracked recommend inventory subnum.
    </p>
]]>
</remarks>
</documentation>
</command>