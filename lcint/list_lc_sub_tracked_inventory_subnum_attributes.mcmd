<command>
<name>list lc sub tracked inventory subnum attributes</name>
<description>list lc sub tracked inventory subnum attributes</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

list lc wrkref client id
 where wrkref = @wrkref catch(-1403)
|
list lc wrkref pckuom
 where wrkref = @wrkref catch(-1403)
|
list policies
 where polcod = 'LC_PICK'
   and polvar = 'SKIP_REPEATED_SCAN'
   and polval = 'INSTALL'
   and rtstr1 = @client_id
   and wh_id = @wh_id
   and rtnum1 = 1 catch(-1403)
|
if (@? = 0 and @pck_uom = 'CS')
{
    /* No existing MOCA list command, use select statement instead.
     * Retrieve data from some tables directly since there is no view for these tables. 
     * Use decode to prevent divide by zero errors */
    [select decode(prtftp_dtl.untqty, 0, 0, floor(sum(iv.untqty) / prtftp_dtl.untqty)) untqty,
            prtftp_dtl.untqty untcas,
            iv.stoloc
       from inventory_view iv
       join prtftp_dtl
         on prtftp_dtl.prtnum = iv.prtnum
        and prtftp_dtl.ftpcod = iv.ftpcod
        and prtftp_dtl.prt_client_id = iv.prt_client_id
        and prtftp_dtl.wh_id = iv.wh_id
        and prtftp_dtl.uomcod = 'CS'
      where iv.subnum = @lodnum
      group by iv.subnum,
            iv.stoloc,
            prtftp_dtl.untqty] catch(-1403)
    |
    if(@untcas = @rtnum2)
    {
        publish data
         where dvc_var_nam = 'untqty,stoloc,uomcod'
           and dvc_ena_flg = '0,0,0'
           and dvc_vis_flg = '1,1,1'
           and untqty = nvl(@untqty, 0)
           and stoloc = @stoloc
           and uomcod = 'CS'
    }
    else
    {
        publish data
         where dvc_var_nam = 'untqty,stoloc,uomcod'
           and dvc_ena_flg = '1,1,1'
           and dvc_vis_flg = '1,1,1'
           and untqty = nvl(@untqty, 0)
           and stoloc = @stoloc
           and uomcod = 'CS'
    }
    
}


]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-63062
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-10-22
    <p>
    This command is used to list lc sub tracked inventory subnum attributes.
    </p>
]]>
</remarks>
</documentation>
</command>