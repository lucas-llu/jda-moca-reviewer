<command>
<name>list lc order expected qty</name>
<description>list lc order expected qty</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

/* No existing MOCA list command, use select statement instead. 
 * Retrieve data from some tables directly since there is no view for these tables.
 */
[select sum(pckqty) expected_qty
   from inventory_pckwrk_view
  where subnum = @subnum
    and client_id = @client_id]


]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-58488
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-10-14
    <p>
    This command is used to list lc order expected qty.
    </p>
]]>
</remarks>
</documentation>
</command>