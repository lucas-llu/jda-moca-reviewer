<command>
<name>list lc shipped order details</name>
<description>list lc shipped order details</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables.
 * Use NOT IN ('B','C') instead of AND chains for clarity and easier maintenance; performance is identical.
 */
[select distinct shipment_line.ordnum,
        shipment_line.client_id,
        shipment_line.wh_id
   from car_move
   join stop
     on car_move.car_move_id = stop.car_move_id
   join shipment
     on stop.stop_id = shipment.stop_id
   join shipment_line
     on shipment.ship_id = shipment_line.ship_id
    and shipment_line.linsts <> 'B'
  where car_move.trlr_id = @trlr_id
    and car_move.wh_id = @wh_id]


]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-58488
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-10-14
    <p>
    This command is used to list lc shipped order details.
    </p>
]]>
</remarks>
</documentation>
</command>