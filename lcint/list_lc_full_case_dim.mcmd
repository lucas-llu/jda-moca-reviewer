<command>
<name>list lc full case dim</name>
<description>list lc full case dim</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

/* No existing MOCA list command, use select statement instead. 
 * Retrieve data from some tables directly since there is no view for these tables.
 */
[select pv.caslen,
        pv.caswid,
        pv.cashgt,
        pv.netwgt,
        pv.grswgt
   from prtftp_view pv
   join inventory_view iv
     on iv.prtnum = pv.prtnum
    and iv.prt_client_id = pv.prt_client_id
    and iv.wh_id = pv.wh_id
    and iv.ftpcod = pv.ftpcod
  where iv.subnum = @subnum
    and iv.wh_id = @wh_id
    and rownum = 1]


]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-58488
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-10-14
    <p>
    This command is used to list lc full case dim.
    </p>
]]>
</remarks>
</documentation>
</command>