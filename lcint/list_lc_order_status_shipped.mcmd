<command>
<name>list lc order status shipped</name>
<description>list lc order status shipped</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables.
 */
[select distinct shipment_line.ordnum,
        shipment_line.client_id,
        shipment_line.wh_id
   from shipment_line
   join shipment
     on shipment_line.ship_id = shipment.ship_id
   join stop
     on shipment.stop_id = stop.stop_id
  where stop.car_move_id = @car_move_id]


]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-58488
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-10-14
    <p>
    This command is used to list lc order status shipped.
    </p>
]]>
</remarks>
</documentation>
</command>