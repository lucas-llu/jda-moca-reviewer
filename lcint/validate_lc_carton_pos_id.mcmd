<command>
<name>validate lc carton pos id</name>
<description>validate lc carton pos id</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

list lc wrkref client id
 where wrkref = @wrkref
|
list policies
 where polcod = 'LC_CARTON'
   and polvar = 'POS_ID'
   and polval = 'INSATLL'
   and rtstr1 = @client_id
   and rtnum1 = 1 
   and wh_id = nvl(@wh_id, @@wh_id)catch(-1403)
|
if (@? = 0)
{
    validate stack variable not null
     where name = 'pos_id'
}






]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-60987
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-10-22
    <p>
    This command is used to validate lc carton pos id.
    </p>
]]>
</remarks>
</documentation>
</command>