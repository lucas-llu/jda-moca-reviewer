<command>
  <name>list lc package quantity by subnum and prtnum</name>
  <description>list lc package quantity by subnum and prtnum</description>
  <type>Local Syntax</type>
  <local-syntax> 
<![CDATA[

/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables.
 */
[select sum(untqty) pkg_qty
   from inventory_view
  where subnum = @subnum
    and prtnum = @prtnum]

]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-67708
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2026-03-31
    <p>
    This command is used to list lc package quantity by subnum and prtnum.
    </p>
]]>
</remarks>
</documentation>
</command>
