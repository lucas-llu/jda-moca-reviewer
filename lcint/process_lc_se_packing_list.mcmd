<command>
<name>process lc se packing list</name>
<description>process lc se packing list</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

/* Validating the stack variable ship_id */
validate stack variable not null
 where name = 'ship_id' catch(802)
|
if (@? = 0)
{
    {
        list shipment lines
         where ship_id = @ship_id
           and wh_id = @wh_id
           and rownum = 1
        |
        publish data
         where client_id = @client_id
    }
    |
    list policies
     where polcod = 'LC_PACK_LIST'
       and polvar = 'SHIPMENT_STAGE'
       and polval = 'INSTALLED'
       and rtstr1 = @client_id
       and wh_id = nvl(@wh_id, @@wh_id)
       and rtnum1 = 1 catch(-1403)
    |
    publish data
     where copy_num = @rtnum2
    |
    if (@? = 0)
    {
        /*when rtnum1 = 1, print report */
        hide stack variable
         where name = 'actdte'
        |
        hide stack variable
         where name = 'moddte'
        |
        hide stack variable
         where name = 'devcls'
        |
        hide stack variable
         where name = 'prtadr'
        |
        list devices
         where devcod = nvl(@devcod, @@devcod)
           and wh_id = @wh_id catch(-1403)
        |
        if (@? != 0 or @prtadr is null)
        {
            list report configurations
             where rpt_id = nvl(@rtstr2, 'Lc-In02-PackList') catch(-1403, 510)
            |
            publish data
             where prtadr = @def_printer
        }
        |
        do loop
         where count = nvl(@copy_num, 1)
        |
        generate moca report
         where rpt_id = nvl(@rtstr2, 'Lc-In02-PackList')
           and dest_typ = 'printer'
           and dest = @prtadr
           and num_copies = '1'
           and gen_usr_id = nvl(@usr_id, @@usr_id)
           and locale_id = nvl(nvl(@locale_id, @@locale_id), 'EN-GB')
           and exec_typ = 'RPT'
           and wh_id = @wh_id
           and ship_id = @ship_id catch(@?)
    }
}

]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-60323
    @author Reko/Lydia Luo
    @version 1.0.0
    @since 2025-11-20

    <p>
        This command is used to process lc se packing list report.
    </p>
]]>
</remarks>

</documentation>
</command>