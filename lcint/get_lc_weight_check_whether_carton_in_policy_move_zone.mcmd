<command>
  <name>get lc weight check whether carton in policy move zone</name>
  <description>get lc weight check whether carton in policy move zone</description>
  <type>Local Syntax</type>
  <local-syntax>
    
<![CDATA[

/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables. */
[select 'x'
   from inventory_view iv
   join poldat pd
     on iv.prt_client_id = pd.rtstr1
    and pd.wh_id_tmpl = iv.wh_id
   join locmst lm
     on lm.stoloc = iv.stoloc
    and lm.wh_id = iv.wh_id
   join mov_zone mz
     on mz.mov_zone_id = lm.mov_zone_id
    and mz.mov_zone_cod = pd.rtstr2
  where pd.polcod = 'LC_WEIGHT_CHECK'
    and pd.polvar = 'VALIDATION'
    and pd.polval = 'MOVEMENT_ZONE_CODE'
    and iv.subnum = @subnum
    and iv.wh_id = @wh_id
    and rownum = 1]

]]>    
  </local-syntax>
  <argument name="wh_id" required="yes" datatype="string">Warehouse ID</argument>
  <argument name="subnum" required="yes" datatype="string">Sub-LPN</argument>
  <documentation>
    <remarks>
      @author Kevin Wang
      @since 2025-10-24
      SWIFTLEX-57791
      get lc weight check if carton in policy move zone
    </remarks>
  </documentation>
</command>
