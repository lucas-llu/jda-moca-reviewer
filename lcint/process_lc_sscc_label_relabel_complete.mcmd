<command>
  <name>process lc sscc label relabel complete</name>
  <description>process lc sscc label relabel complete</description>
  <type>Local Syntax</type>
  <local-syntax> 
<![CDATA[

list devices
 where devcod = @devcod
   and wh_id = @wh_id catch(@?)
|
publish data
 where printer = @lbl_prtadr
|
change inventory identifier
 where lodlvl = 'S'
   and from_id = @invtid
   and to_id = @sscc_num
   and wh_id = @wh_id catch(@?)
|
if (@? = 0)
{
    list lc sscc label relabel package detail
     where sscc_num = @sscc_num catch(-1403)
    |
    if (@uc_pkg_id is null)
    {
        list lc full case dim
         where wh_id = @wh_id
           and subnum = @sscc_num
        |
        process usr package for outbound order
         where entity_type = 'INVSUB'
           and entity_key = @sscc_num
           and pkgtype = 'CASE'
           and pkglen = @caslen
           and pkgwdt = @caswid
           and pkghgt = @cashgt
           and grswgt = @grswgt
           and netwgt = @netwgt
    }
    |
    update lc packing sscc label packing date
     where ordnum = @ordnum
       and wh_id = @wh_id
       and client_id = @client_id
    |
    generate label
     where locale_id = nvl(@locale_id, @@locale_id)
       and label_name = 'Lc-PackingSsccLabel'
       and client_id = @client_id
       and wh_id = @wh_id
       and ship_id = @ship_id
       and ordnum = @ordnum
       and subnum = @sscc_num catch(@?)
    |
    if (@? = 0)
    {
        print lbl label operations label
         where filename = @outfile_name
           and prtadr = @printer catch(@?)
        |
        list lc sscc label relabel next location
         where sscc_num = @sscc_num
           and wh_id = @wh_id catch(-1403)
        |
        if (@? = 0 and @dstloc is not null)
        {
            execute server command
             where cmd = "move inventory where srcsub ='" || @mov_sub || "' and dstloc ='" || @dstloc || "' and wh_id = '" || @wh_id || "' and newdst = '1' catch(@?)"
               and inline = 0
        }
    }
}

]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-60987
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-10-22
    <p>
    This command is used to process lc sscc label relabel complete.
    </p>
]]>
</remarks>
</documentation>
</command>
