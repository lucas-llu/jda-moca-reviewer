<command>
<name>validate lc sscc relabel sscc number</name>
<description>validate lc sscc relabel sscc number</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

check lc sscc relabel serial number
 where invtid = @invtid
   and wh_id = @wh_id;
/* validate sscc number */
list lc carton ready to complete for pick enhancement
 where subnum = @sscc_num
   and new_carton_start_position = 3 catch(@?) >>carton_complete_res
|
if (rowcount(@carton_complete_res) > 0)
{
    set return status
     where status = 4100013
       and ctnnum = @sscc_num
};
list lc package client id
 where subnum = @invtid catch(-1403)
|
list policies
 where polcod = 'LC_SSCC_NUM'
   and polvar = 'TOTAL_LENGTH_VALIDATION'
   and polval = 'INSTALL'
   and rtstr1 = @client_id
   and rtnum1 = 1 
   and wh_id = nvl(@wh_id, @@wh_id)catch(-1403)
|
if (@? = 0)
{
    list policies
     where polcod = 'LC_SSCC_NUM'
       and polvar = 'TOTAL_LENGTH'
       and polval = 'LENGTH'
       and rtstr1 = @client_id
       and rtnum1 = len(@sscc_num)
       and wh_id = nvl(@wh_id, @@wh_id) catch(-1403)
    |
    if (@? <> 0)
    {
        set return status
         where status = 4100009
    }
}
|
list policies
 where polcod = 'LC_SSCC_NUM'
   and polvar = 'DIGIT_NUM_VALIDATION'
   and polval = 'INSTALL'
   and rtstr1 = @client_id
   and rtnum1 = 1 
   and wh_id = nvl(@wh_id, @@wh_id)catch(-1403)
|
if (@? = 0)
{
    publish data
     where prefix_len = @rtstr2
    |
    list policies
     where polcod = 'LC_SSCC_NUM'
       and polvar = 'DIGIT_NUM'
       and polval = 'NUMBER'
       and rtstr1 = @client_id
       and rtstr2 = substr(@sscc_num, 3, @prefix_len)
       and wh_id = nvl(@wh_id, @@wh_id) catch(-1403)
    |
    if (@? <> 0)
    {
        set return status
         where status = 4100010
    }
}
|
list policies
 where polcod = 'LC_RELABEL'
   and polvar = 'SSCC_LABEL'
   and polval = 'INSTALL'
   and wh_id = nvl(@wh_id, @@wh_id)
   and rtstr1 = @client_id
   and rtnum1 = 1 catch(-1403)
|
if (@? = 0)
{
    list lc sscc relabel pick method
     where invtid = @invtid
    |
    list policies
     where polcod = 'LC_RELABEL'
       and polvar = 'SSCC_LABEL'
       and polval = 'SSCC_PREFIX'
       and wh_id = nvl(@wh_id, @@wh_id)
       and rtstr1 = @pck_mthd_nam
       and rtstr2 = substr(@sscc_num, 1, 2)
       and rtnum1 = 1 catch(-1403)
    |
    if (@? <> 0)
    {
        set return status
         where status = 4100011
    }
}
|
list policies
 where polcod = 'LC_SSCC_NUM'
   and polvar = 'REMOVE_SSCC_PREFIX'
   and polval = 'INSTALL'
   and rtstr1 = @client_id
   and wh_id = nvl(@wh_id, @@wh_id)
   and rtnum1 = 1 catch(-1403)
|
if (@? = 0)
{
    publish data 
     where sscc_num = substr(@sscc_num, 3)
}
|
list lc package client id
 where subnum = @sscc_num catch(-1403)
|
if (@? = 0)
{
    set return status
     where status = 4100016
}
|
publish data
 where sscc_num = @sscc_num



]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-60987
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-10-22
    <p>
    This command is used to validate lc sscc relabel sscc number.
    </p>
]]>
</remarks>
</documentation>
</command>