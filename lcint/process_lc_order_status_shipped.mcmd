<command>
<name>process lc order status shipped</name>
<description>process lc order status shipped</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

list lc shipped order details
 where trlr_id = @trlr_id
|
list lc order ready ordtyp
 where ordnum = @ordnum
   and wh_id = @wh_id
   and client_id = @client_id
|
if (@? = 0)
{
    process lc outbound order ready
     where wh_id = @wh_id
       and client_id = @client_id
       and ordnum = @ordnum
       and order_status = 'SHIPPED'
}


]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-58488
