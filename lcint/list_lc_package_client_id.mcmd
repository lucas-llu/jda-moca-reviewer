<command>
<name>list lc package client id</name>
<description>list lc package client id</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

if (@lodnum is null)
{
    hide stack variable
     where name = 'lodnum'
}
|
if (@subnum is null)
{
    hide stack variable
     where name = 'subnum'
}
|
if (@dtlnum is null)
{
    hide stack variable
     where name = 'dtlnum'
}
|
/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables.
 */
[select client_id
   from inventory_pckwrk_view
  where @+lodnum
    and @+subnum
    and @+dtlnum
    and rownum < 2]




]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-60987
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-10-22
    <p>
    This command is used to list lc package client id.
    </p>
]]>
</remarks>
</documentation>
</command>