<command>
<name>log lc uin order cancel event</name>
<description>log lc uin order cancel event</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

validate stack variable not null
 where name = 'ordlin' catch(@?)
|
if (@? <> 0)
{
    list policies
     where polcod = 'LC_ORDER_CANCEL'
       and polvar = 'INSTALLED'
       and polval = 'INSTALLED'
       and wh_id = @wh_id
       and rtstr1 = @client_id
       and rtnum1 = 1
       and rownum = 1 catch(-1403)
    |
    if (@? = 0)
    {
        get integrator system id
         where systyp = 'WMD'
        |
        sl_log event
         where evt_id = 'LC-UIN-ORD-CANCEL-OUB-EVT'
           and sys_id = @sys_id
           and ifd_data_ptr = NULL
           and wh_id = @wh_id
           and client_id = @client_id
           and ordnum = @ordnum
    }
}

]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-58488
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-12-15
    <p>
        This command is used to log uin order cancel event.
    </p>
]]>
</remarks>

</documentation>
</command>
