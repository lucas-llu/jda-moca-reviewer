<command>
<name>validate lc sscc reprint sscc number</name>
<description>validate lc sscc reprint sscc number</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

validate key exists
 where table = 'invsub'
   and key = 'subnum'
   and subnum = @sscc_num catch(@?)
|
if (@? <> 0)
{
    validate key exists
     where table = 'invsub_hist'
       and key = 'subnum'
       and subnum = @sscc_num catch(@?)
    |
    if (@? <> 0)
    {
        set return status
         where status = 4100006
    }
}


]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-60987
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-10-22
    <p>
    This command is used to validate lc sscc reprint sscc number.
    </p>
]]>
</remarks>
</documentation>
</command>