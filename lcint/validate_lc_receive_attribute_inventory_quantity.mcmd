<command>
<name>validate lc receive attribute inventory quantity</name>
<description>validate lc receive attribute inventory quantity</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

publish data
 where trknum = @trknum
   and wh_id = nvl(@wh_id, @@wh_id)
   and client_id = @client_id
   and rcvqty = @rcvqty
   and prtnum = @prtnum
|
list policies
 where polcod = 'LC_RECEIVE'
   and polvar = 'INVENTORY_ATTRIBUTE'
   and polval = 'RCVQTY_CHECK'
   and rtstr1 = @client_id
   and wh_id = nvl(@wh_id, @@wh_id)
   and rtnum1 = 1 catch(-1403)
|
if (@? = 0)
{
    /* No existing MOCA list command, use select statement instead.
     * Retrieve data from some tables directly since there is no view for these tables.
     */
    [select prtnum,
            sum(expqty) total_expqty,
            sum(idnqty) total_idnqty,
            inv_attr_str1
       from rcvlin
      where trknum = @trknum
        and client_id = @client_id
        and wh_id = @wh_id
        and prtnum = @prtnum
        and idnqty < expqty
      group by prtnum,
            inv_attr_str1
      order by inv_attr_str1] catch(-1403) >> res_rcv
    |
    publish top rows
     where res = @res_rcv
       and rows = 1
    |
    if ((@total_expqty - @total_idnqty - @rcvqty) < 0)
    {
        publish data
         where rem_qty = (@total_expqty - @total_idnqty)
           and prtnum = @prtnum
           and inv_attr_str1 = @inv_attr_str1
        |
        set return status
         where status = 4100021
           and prtnum = @prtnum
           and inv_attr_str1 = nvl(@inv_attr_str1, ' ')
           and rem_qty = @rem_qty
    }
}



]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-61837
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2026-01-05
    <p>
    This command is used to validate lc receive attribute inventory quantity.
    </p>
]]>
</remarks>
</documentation>
</command>