<command>
<name>list lc uin line note by cancel order line</name>
<description>list lc uin line note by cancel order line</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

/* No existing MOCA list command, use select statement instead.
 * Retrieve data from table directly since there is no view for the table.
 * The primary-key column "notlin" is not passed in the WHERE clause because its value
 * cannot be obtained from the current session context.
 */
[select min(nottxt)
   from ord_line_note
  where client_id = @client_id
    and ordnum = @ordnum
    and ordlin = @ordlin
    and ordsln = '0000'
    and nottyp = @nottyp
    and wh_id = @wh_id] catch(-1403)

]]>
</local-syntax>
<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-58488
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-12-15
    <p>
        This command is used to list lc uin order line note by cancel order.
    </p>
]]>
</remarks>

</documentation>
</command>
