<command>
<name>process lc order status packed</name>
<description>process lc order status packed</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

if (@lodnum is null)
{
    hide stack variable
     where name = 'lodnum'
}
|
if (@subnum is null)
{
    hide stack variable
     where name = 'subnum'
}
|
if (@dtlnum is null)
{
    hide stack variable
     where name = 'dtlnum'
}
|
/* No existing MOCA list command, use select statement instead. */
[select distinct ordnum,
        client_id,
        ship_id
   from inventory_pckwrk_view
  where @+lodnum
    and @+subnum
    and @+dtlnum]
|
list policies
 where polcod = 'LC_OUTBOUND'
   and polvar = 'ORDER_READY'
   and polval = 'ENABLED'
   and wh_id = @wh_id
   and rtstr1 = @client_id
   and rtnum1 = 1 catch(-1403)
|
if (@? = 0)
{
    list lc order ready ordtyp
     where ordnum = @ordnum
       and wh_id = @wh_id
       and client_id = @client_id catch(-1403)
    |
    if (@? = 0)
    {
        list lc order status packed
         where client_id = @client_id
           and ordnum = @ordnum
           and wh_id = @wh_id
        |
        if (@value = 'PICKED')
        {
            /* No existing MOCA list command, use select statement instead. */
            [select distinct wrktyp,
                    lodlvl
               from pckwrk_view
              where ship_id = @ship_id
                and client_id = @client_id] >> pckwrk_res
            |
            convert column results to string
             where resultset = @pckwrk_res
               and colnam = 'wrktyp'
               and separator = ','
            |
            publish data
             where wrktyp_list = @result_string
            |
            if (@wrktyp_list like '%K%')
            {
                publish data
                 where carton_flg = 1
            }
            |
            if (rowcount(@pckwrk_res) = 1 and @carton_flg <> 1)
            {
                publish data
                 where case_flg = 1
            }
            |
            if (@case_flg = '1')
            {
                list lc order expected qty
                 where ordnum = @ordnum
                   and wh_id = @wh_id
                   and client_id = @client_id
                |
                list lc case packed qty
                 where ordnum = @ordnum
                   and ship_id = @ship_id
                   and client_id = @client_id
                |
                if (@case_packed_qty = @expected_qty)
                {
                    publish data
                     where send_message = 1
                }
            }
            |
            if (@carton_flg = '1')
            {
                list lc order expected qty
                 where ordnum = @ordnum
                   and wh_id = @wh_id
                   and client_id = @client_id
                |
                list lc order packed qty
                 where ordnum = @ordnum
                   and ship_id = @ship_id
                   and client_id = @client_id
                |
                if (@packed_qty = @expected_qty)
                {
                    publish data
                     where send_message = 1
                }
            }
            |
            if (@send_message = 1)
            {
                process lc outbound order ready
                 where wh_id = @wh_id
                   and client_id = @client_id
                   and ordnum = @ordnum
                   and order_status = 'PACKED'
            }
        }
    }
}


]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-58488
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-10-14
    <p>
    This command is used to process lc order status packed.
    </p>
]]>
</remarks>
</documentation>
</command>