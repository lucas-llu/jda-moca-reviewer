<command>
<name>list lc order ready ordtyp</name>
<description>list lc order ready ordtyp</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables.
 * Use poldat instead of poldat_view for better performance.
 * Validate order type and client id is enabled for this policy.
 */
[select 'x'
   from ord
   join poldat
     on poldat.polcod = 'LC_OUTBOUND'
    and poldat.polvar = 'ORDER_READY'
    and poldat.polval = 'ORDER_TYPE'
    and poldat.wh_id_tmpl = ord.wh_id
    and poldat.rtstr1 = ord.client_id
    and poldat.rtstr2 = ord.ordtyp
  where ord.ordnum = @ordnum
    and ord.wh_id = @wh_id
    and ord.client_id = @client_id
    and poldat.rtnum1 = 1
    and rownum = 1]


]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-58488
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-10-14
    <p>
    This command is used to list lc order ready ordtyp.
    </p>
]]>
</remarks>
</documentation>
</command>