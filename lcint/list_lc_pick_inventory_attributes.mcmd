<command>
<name>list lc pick inventory attributes</name>
<description>list lc pick inventory attributes</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables. */
[select inv_attr_str1,
        client_id
   from pckwrk_view
  where wrkref = @wrkref
    and rownum = 1] catch(-1403)
|
list policies
 where polcod = 'LC_PICK'
   and polvar = 'INV_ATTR_VALIDATION'
   and polval = 'INSTALL'
   and rtstr1 = @client_id
   and wh_id = @wh_id
   and rtnum1 = 1 catch(-1403)
|
if (@? = 0)
{
    publish data
     where dvc_var_nam = 'inv_attr_str1'
       and dvc_ena_flg = '0'
       and dvc_vis_flg = decode(@inv_attr_str1, null, 0, 1)
       and inv_attr_str1 = @inv_attr_str1
}


]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-63062
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-10-22
    <p>
    This command is used to list lc pick inventory attributes.
    </p>
]]>
</remarks>
</documentation>
</command>