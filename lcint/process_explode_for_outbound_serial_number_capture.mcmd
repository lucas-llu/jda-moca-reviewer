<command>
  <name>process explode for outbound serial number capture</name>
  <description>process explode for outbound serial number capture</description>
  <type>Local Syntax</type>
  <local-syntax>
<![CDATA[

list policies
 where polcod = 'LC_OUTBOUND'
   and polvar = 'SERIAL_CAPTURE'
   and polval = 'INSTALL'
   and wh_id = nvl(@wh_id, @@wh_id)
   and rtnum1 = 1 catch(-1403)
|
if (@? = 0)
{
    ^process explode for outbound serial number capture
     where picked_inv = 1
       and @*
}
else
{
    ^process explode for outbound serial number capture
}


]]>    
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-60057
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-11-14
    <p>
    This command is used to process explode for outbound serial number capture.
    </p>
]]>
</remarks>
</documentation>
</command>
