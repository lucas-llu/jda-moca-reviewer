<command>
<name>list lc pick list by sequence</name>
<description>list lc pick list by sequence</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

    list tables with column
    where column = @sort_by catch(-1403) >> rs
    |
    if(@? = 0)
    {
        /* No existing MOCA list command, use select statement instead.
         * Retrieve data from some tables directly since there is no view for these tables.
         * Get the seq by criteria.
         * sort_by could only be valid column in tables.
         */
        [select tbl.wrkref, row_number() over(order by @sort_by:raw) seq  from (
            select list_id,wrkref,srcloc,list_seqnum,wrktyp,pck_uom,locmst.trvseq
              from pckwrk_view join locmst on locmst.stoloc = pckwrk_view.srcloc and locmst.wh_id = pckwrk_view.wh_id
             where list_id = @list_id
             union all
            select list_id,wrkref,srcloc,list_seqnum,wrktyp,pck_uom,locmst.trvseq
              from pckwrk_view pv join locmst on locmst.stoloc = pv.srcloc and locmst.wh_id = pv.wh_id
                where exists (select 'x' from pckwrk_view where list_id = @list_id and wrktyp = 'K' and subnum = pv.ctnnum)) tbl
        ]
    }

]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-67708
    @author Reko/Steven Chen
    @version 1.0.0
    @since 2026-04-02
    <p>
    This command is used to list the new seq by sort by field
    </p>
]]>
</remarks>
</documentation>
</command>