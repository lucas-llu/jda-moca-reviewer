<command>
  <name>get lc weight check policy condition</name>
  <description>get lc weight check policy condition</description>
  <type>Local Syntax</type>
  <local-syntax>
    
<![CDATA[

/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables. */
[select 'OUT_WEIGHT_THRESHOLD' policy_condition
   from poldat
  where polcod = 'LC_WEIGHT_CHECK'
    and polvar = 'VALIDATION'
    and polval = 'WEIGHT_THRESHOLD'
    and rtstr1 = @client_id
    and wh_id_tmpl = @wh_id
    and rtnum1 < (to_number(@weight_diff) * 1000)
    and (rtstr2 is null and not exists(Select 'x'
                                         from poldat b
                                        where b.polcod = 'LC_WEIGHT_CHECK'
                                          and b.polvar = 'VALIDATION'
                                          and b.polval = 'WEIGHT_THRESHOLD'
                                          and b.rtstr1 = @client_id
                                          and b.rtstr2 = @ctncod
                                          and b.wh_id_tmpl = @wh_id) or rtstr2 = @ctncod)] catch(@?) &
[select 'DCR_ITEM' policy_condition
   from poldat
  where polcod = 'LC_WEIGHT_CHECK'
    and polvar = 'WEIGHT_CHECK_CONDITION'
    and polval = 'DCR_ITEM'
    and rtstr1 = @client_id
    and rtstr2 @prtnum_in_clause:raw
    and wh_id_tmpl = @wh_id
    and rtnum1 = 1
    and rownum = 1] catch(@?) &
[select 'NEW_ITEM' policy_condition
   from poldat
  where polcod = 'LC_WEIGHT_CHECK'
    and polvar = 'WEIGHT_CHECK_CONDITION'
    and polval = 'NEW_ITEM'
    and rtstr1 = @client_id
    and rtstr2 @prtnum_in_clause:raw
    and wh_id_tmpl = @wh_id
    and rtnum1 = 1
    and rownum = 1] catch(@?) &
[select 'VIP_CUSTOMER' policy_condition
   from poldat
  where polcod = 'LC_WEIGHT_CHECK'
    and polvar = 'WEIGHT_CHECK_CONDITION'
    and polval = 'VIP_CUSTOMER'
    and rtstr1 = @client_id
    and rtstr2 = @custmor
    and wh_id_tmpl = @wh_id
    and rtnum1 = 1] catch(@?) &
[select 'NEW_PICKER' policy_condition
   from poldat
  where polcod = 'LC_WEIGHT_CHECK'
    and polvar = 'WEIGHT_CHECK_CONDITION'
    and polval = 'NEW_PICKER'
    and rtstr1 = @client_id
    and rtstr2 = @usr_id
    and wh_id_tmpl = @wh_id
    and rtnum1 = 1] catch(@?) &
[select 'BELOW_MIN_WEIGHT' policy_condition
   from poldat
  where polcod = 'LC_WEIGHT_CHECK'
    and polvar = 'WEIGHT_CHECK_CONDITION'
    and polval = 'MIN_WEIGHT'
    and rtstr1 = @client_id
    and rtflt1 > to_number(@lp_weight) * 1000
    and wh_id_tmpl = @wh_id
    and rtnum1 = 1] catch(@?) &
[select 'FORCE_INSPECT' policy_condition
   from poldat
  where polcod = 'LC_WEIGHT_CHECK'
    and polvar = 'WEIGHT_CHECK_CONDITION'
    and polval = 'FORCE_INSPECT'
    and rtstr1 = @client_id
    and wh_id_tmpl = @wh_id
    and rtnum1 = 1] catch(@?) &
[select 'NO_GTIN_EAN' policy_condition
   from dual
  where not exists(select 'x'
                     from alt_prtmst
                    where prtnum @prtnum_in_clause:raw
                      and prt_client_id = @client_id
                      and alt_prt_typ in ('GTIN', 'EAN')
                      and rownum < 2)] catch(@?)

]]>    
  </local-syntax>
  <argument name="wh_id" required="yes" datatype="string">Warehouse ID</argument>
  <argument name="client_id" required="yes" datatype="string">Client ID</argument>
  <argument name="ctncod" required="yes" datatype="string">Carton Code</argument>
  <argument name="weight_diff" required="yes" datatype="float">Weight Difference</argument>
  <argument name="lp_weight" required="yes" datatype="float">Lightest Product Weight</argument>
  <argument name="usr_id" required="yes" datatype="string">User ID</argument>
  <argument name="prtnum_in_clause" required="yes" datatype="string">Prtnum In Clause</argument>
  <argument name="custmor" required="yes" datatype="string">Customer Number</argument>
  <documentation>
    <remarks>
      @author Kevin Wang
      @since 2025-10-24
      SWIFTLEX-57791
      get lc weight check policy condition
      an example of prtnum_in_clause: IN ('ITEM02','ITEM01')
    </remarks>
  </documentation>
</command>
