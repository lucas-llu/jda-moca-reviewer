<command>
  <name>list lc inspect inventory details in carton</name>
  <description>list lc inspect inventory details in carton</description>
  <type>Local Syntax</type>
  <local-syntax>
    
<![CDATA[

/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables. */
[select inventory_view.prtnum,
        prtdsc.lngdsc,
        alt_ip.alt_prtnum ip_alt_prtnum,
        alt_ea.alt_prtnum ea_alt_prtnum,
        nvl(prt_ip.untqty, 0) uomqty,
        sum(inventory_view.untqty) picked_qty
   from inventory_view
   join prtdsc /*#nobind*/
     on prtdsc.colnam = 'prtnum|prt_client_id|wh_id_tmpl'
    and prtdsc.colval = inventory_view.prtnum || '|' || inventory_view.prt_client_id || '|' || inventory_view.wh_id /*#bind*/
   left
   join alt_prtmst alt_ip
     on alt_ip.prtnum = inventory_view.prtnum
    and alt_ip.prt_client_id = inventory_view.prt_client_id
    and alt_ip.alt_prt_typ in ('GTIN', 'EAN')
    and alt_ip.uomcod = 'IP'
   left
   join alt_prtmst alt_ea
     on alt_ea.prtnum = inventory_view.prtnum
    and alt_ea.prt_client_id = inventory_view.prt_client_id
    and alt_ea.alt_prt_typ in ('GTIN', 'EAN')
    and alt_ea.uomcod = 'EA'
   left
   join prtftp_dtl prt_ip
     on prt_ip.prtnum = inventory_view.prtnum
    and prt_ip.ftpcod = inventory_view.ftpcod
    and prt_ip.prt_client_id = inventory_view.prt_client_id
    and prt_ip.wh_id = inventory_view.wh_id
    and prt_ip.uomcod = 'IP'
  where inventory_view.subnum = @subnum
    and inventory_view.wh_id = @wh_id
    and prtdsc.locale_id = nvl(@locale_id, 'EN-GB')
  group by inventory_view.prtnum,
        prtdsc.lngdsc,
        alt_ip.alt_prtnum,
        alt_ea.alt_prtnum,
        prt_ip.untqty]

]]>    
  </local-syntax>
  <argument name="wh_id" required="yes" datatype="string">Warehouse ID</argument>
  <argument name="subnum" required="yes" datatype="string">Sub-LPN</argument>
  <argument name="locale_id" datatype="string">Locale Id</argument>
  <documentation>
    <remarks>
      @author Kevin Wang
      @since 2025-10-14
      SWIFTLEX-57791
      list lc inspect inventory details in carton
    </remarks>
  </documentation>
</command>
