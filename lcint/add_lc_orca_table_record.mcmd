<command>
  <name>add lc orca table record</name>
  <description>add lc orca table record</description>
  <type>Local Syntax</type>
  <local-syntax>
<![CDATA[
publish data
 where lc_table_name = @lc_table_name
   and lc_key_columns = @lc_key_columns
|
if (@lc_table_name is not null and @lc_key_columns is not null)
{
    convert list
     where delimiter = ','
       and string = @lc_key_columns
       and type = 'L'
    |
    publish data
     where column_name = @retstr
    |
    {
        list tables with column
         where table_name = @lc_table_name
           and column_name = @column_name catch(-1403)
        |
        if (@? = -1403)
        {
            set return status
             where code = '9999999'
               and error_message = @column_name || ' not found in the table ' || @lc_table_name || '. Please specify a valid column name!'
        }
        else
        {
            noop
        }
        |
        publish data
         where lc_table_name = @lc_table_name
           and lc_key_columns = @lc_key_columns
    }
} >> res
else
{
    set return status
     where code = '9999999'
       and error_message = 'Table Name or the Key Column cannot be Null!'
}
|
if (rowcount(@res) > 0)
{
    create record
     where table_name = 'usr_lc_orca_key_table'
       and lc_table_name = @lc_table_name
       and lc_key_columns = @lc_key_columns
}
]]>
</local-syntax>
</command>