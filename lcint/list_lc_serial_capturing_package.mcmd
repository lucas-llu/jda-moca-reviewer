<command>
<name>list lc serial capturing package</name>
<description>list lc serial capturing package</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

if (@pallet_type = 'lodnum')
{
    list lc serial capturing package lodnum
     where invtid = @invtid
       and wh_id = @wh_id
}
else if (@pallet_type = 'subnum')
{
    list lc serial capturing package subnum
     where invtid = @invtid
       and wh_id = @wh_id
}
|
filter data
 where moca_filter_level = 1
   and scan_type = decode(@pallet_type, 'lodnum', 'PALLET', 'subnum', 'CASE')
   and lodnum = @lodnum
   and subnum = @subnum
   and scan_id = @scan_id


]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-60057
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-11-20
    <p>
    This command is used to list lc serial capturing package.
    </p>
]]>
</remarks>
</documentation>
</command>