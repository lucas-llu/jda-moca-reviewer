<command>
  <name>refresh lc orca data</name>
  <description>refresh lc orca data</description>
  <type>Local Syntax</type>
  <local-syntax>
<![CDATA[
/*Cleanup usr_lc_orca_data before starting the load*/
remove lc orca data catch(@?)
|
if (@? = 0)
{
    /*Direct SQL on table since there is no view or standard MOCA command exists to fetch this data*/
    /*Logic to load only masterdata tables*/
    [select lc_table_name
       from usr_lc_orca_tables
      where lc_table_type = 'M']
    |
    publish data
     where lc_table_name = @lc_table_name
    |
    /*Start loading the usr_lc_orca_data table*/
    save session variable
     where name = 'store_dspseq'
       and value = 0
    |
    save session variable
     where name = 'store_keyseq'
       and value = 0
    |
    {
        /*Fetches all the columns available on the table*/
        list table columns
         where table = @lc_table_name
        |
        publish data
         where lc_column_name = @column_name
           and lc_table_name = @table_name
        |
        /*Direct SQL on table since there is no view or standard MOCA command exists to fetch this data*/
        [select lower(lc_key_columns) lc_key_columns
           from usr_lc_orca_key_table
          where lc_table_name = @lc_table_name] catch(-1403)
        |
        if (@? = 0)
        {
            publish data
             where pk_flg = 0
        }
        |
        if (@lc_key_columns is not null)
        {
            convert list
             where delimiter = ','
               and string = @lc_key_columns
               and type = 'L'
            |
            if (@retstr = @lc_column_name)
            {
                publish data
                 where pk_flg = 1
                   and column_name = @lc_column_name
            }
            else
            {
                noop
            }
        }
        |
        if (@lc_key_columns is not null)
        {
            list primary key for table
             where table = @lc_table_name
            |
            publish data
             where lc_column_name1 = lower(@column_name)
            |
            if (@lc_column_name = @lc_column_name1)
            {
                publish data
                 where ignore_flg = 1
            }
        }
        |
        publish data
         where table_name = @lc_table_name
           and column_name = @lc_column_name
           and lngdsc = @lngdsc
           and comtyp = @comtyp
           and length = @length
           and null_flg = @null_flg
           and pk_flg = @pk_flg
           and ident_flg = @ident_flg
           and column_comment = @column_comment
           and ignore_flg = @ignore_flg
        |
        get session variable
         where name = 'store_dspseq' catch(-1403)
        |
        publish data
         where store_dspseq = @value
        |
        get session variable
         where name = 'store_keyseq' catch(-1403)
        |
        publish data
         where store_keyseq = @value
        |
        if (@column_name = 'wh_id')
        {
            publish data
             where flag = 'W'
        }
        else if (@column_name = 'client_id' or @column_name = 'prt_client_id')
        {
            publish data
             where flag = 'C'
        }
        |
        if (@pk_flg = '1' and @flag <> 'C' and @flag <> 'W')
        {
            publish data
             where store_keyseq = @store_keyseq + 1
               and store_dspseq = null
            |
            save session variable
             where name = 'store_keyseq'
               and value = @store_keyseq
        }
        else
        {
            if (@flag is not null or @column_name = 'ins_dt' or @column_name = 'ins_user_id' or @column_name = 'last_upd_dt' or @column_name = 'last_upd_user_id' or @column_name = 'last_upd_usr_id' or @column_name = 'ins_usr_id' or @column_name = 'mod_usr_id' or @column_name = 'moddte' or @column_name = 'lc_last_change_date' or @column_name = 'lc_last_change_user' or @ignore_flg = 1)
            {
                publish data
                 where store_dspseq = null
            }
            else
            {
                publish data
                 where store_dspseq = @store_dspseq + 1
                |
                save session variable
                 where name = 'store_dspseq'
                   and value = nvl(@store_dspseq, 0)
            }
        }
        |
        get session variable
         where name = 'store_dspseq' catch(-1403)
        |
        publish data
         where store_dspseq = @value
        |
        get session variable
         where name = 'store_keyseq' catch(-1403)
        |
        publish data
         where store_keyseq = @value
        |
        if (@pk_flg = '1' or @column_name = 'wh_id' or @column_name = 'ins_dt' or @column_name = 'ins_user_id' or @column_name = 'last_upd_dt' or @column_name = 'last_upd_user_id' or @column_name = 'last_upd_usr_id' or @column_name = 'ins_usr_id' or @column_name = 'mod_usr_id' or @column_name = 'moddte' or @column_name = 'lc_last_change_date' or @column_name = 'lc_last_change_user' or @ignore_flg = 1)
        {
            publish data
             where store_dspseq = null
        }
        |
        if (@pk_flg = 0)
        {
            publish data
             where store_keyseq = null
        }
        |
        publish data
         where ignore_flg = @ignore_flg
        |
        if (@ignore_flg = 1 or @pk_flg = '1' or @flag is not null or @column_name = 'ins_dt' or @column_name = 'ins_user_id' or @column_name = 'last_upd_dt' or @column_name = 'last_upd_user_id' or @column_name = 'last_upd_usr_id' or @column_name = 'ins_usr_id' or @column_name = 'mod_usr_id' or @column_name = 'moddte' or @column_name = 'lc_last_change_date' or @column_name = 'lc_last_change_user')
        {
            publish data
             where column_comment = null
        }
        |
        if (@flag is not null)
        {
            publish data
             where store_keyseq = null
               and store_dspseq = null
        }
        |
        create record
         where table_name = 'usr_lc_orca_data'
           and lc_table_name = @lc_table_name
           and field = @column_name
           and dspseq = @store_dspseq
           and key = @store_keyseq
           and flag = @flag
           and label = @column_comment catch(@?)
    }
}
]]>
</local-syntax>
</command>