<command>
  <name>remove lc orca data</name>
  <description>remove lc orca data</description>
  <type>Local Syntax</type>
  <local-syntax>
<![CDATA[
/*Direct SQL on table since there is no view or standard MOCA command exists to fetch this data*/
[select 1
   from usr_lc_orca_data
  where rownum < 2] catch(-1403)
|
if (@? = 0)
{
    /*Direct SQL on table since there is no view or standard MOCA command exists to fetch this data*/
    [truncate
       table usr_lc_orca_data] catch(@?)
}
]]>
</local-syntax>
</command>