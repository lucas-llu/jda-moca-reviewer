<command>
<name>list lc packing list item data</name>
<description>list lc packing list item data</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

/*SQL select statement used as no standard list command or view is available*/
[select usr_uc_package_detail.uc_pkg_id,
        sum(aiv.untqty) ||' PCE' untqty,
        aiv.prtnum,
        alt_prtmst.alt_prtnum,
        ord_line_note.nottxt,
        decode(aiv.orgcod, '----', 'IN', aiv.orgcod) orgcod,
        sl.ordnum,
        substr(aiv.subnum, -18) subnum
   from all_inventory_view aiv
   join shipment_line sl
     on aiv.ship_line_id = sl.ship_line_id
    and aiv.wh_id = sl.wh_id
   left
   join ord_line_note
     on ord_line_note.ordnum = sl.ordnum
    and ord_line_note.client_id = sl.client_id
    and ord_line_note.wh_id = sl.wh_id
    and ord_line_note.ordlin = sl.ordlin
    and ord_line_note.ordsln = sl.ordsln
    and ord_line_note.nottyp = 'REF_X9'
   left
   join invsub
     on invsub.subnum = aiv.subnum
    and invsub.lodnum = aiv.lodnum
   left
   join invsub_hist
     on invsub_hist.subnum = aiv.subnum
    and invsub_hist.lodnum = aiv.lodnum
   join usr_uc_package_detail
     on usr_uc_package_detail.uc_pkg_id = nvl(invsub.uc_pkg_id, invsub_hist.uc_pkg_id)
   left
   join alt_prtmst
     on alt_prtmst.prtnum = sl.prtnum
    and alt_prtmst.prt_client_id = sl.prt_client_id
    and alt_prtmst.alt_prt_typ = 'EAN'
    and alt_prtmst.uomcod = decode(usr_uc_package_detail.uc_pkgtype, 'CN', 'CS', 'EA')
  where sl.ship_id = @ship_id
    and sl.wh_id = @wh_id
  group by usr_uc_package_detail.uc_pkg_id,
        aiv.prtnum,
        alt_prtmst.alt_prtnum,
        ord_line_note.nottxt,
        aiv.orgcod,
        sl.ordnum,
        aiv.subnum
  order BY ordnum,
        subnum,
        prtnum]

]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-60323
    @author Reko/Lydia Luo
    @version 1.0.0
    @since 2025-11-19

    <p>
        This command is used to list packing item data for sub-report 1.
    </p>
]]>
</remarks>

</documentation>
</command>