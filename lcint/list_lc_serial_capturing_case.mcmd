<command>
<name>list lc serial capturing case</name>
<description>list lc serial capturing case</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

if (@scan_type = 'PALLET')
{
    /* No existing MOCA list command, use select statement instead.
     * Retrieve data from some tables directly since there is no view for these tables.
     */
    [select distinct subnum
       from inventory_view
      where lodnum = @lodnum]
}
else if (@scan_type = 'CASE')
{
    /* No existing MOCA list command, use select statement instead.
     * Retrieve data from some tables directly since there is no view for these tables.
     */
    [select dtlnum
       from inventory_view
      where subnum = @subnum]
}
|
publish data
 where subnum = decode(@scan_type, 'PALLET', @subnum, null)
   and dtlnum = decode(@scan_type, 'CASE', @dtlnum, null)


]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-60057
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-11-20
    <p>
    This command is used to list lc serial capturing case.
    </p>
]]>
</remarks>
</documentation>
</command>