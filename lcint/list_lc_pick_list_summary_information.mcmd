<command>
<name>list lc pick list summary information</name>
<description>list lc pick list summary information</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

list lc pick list client id
  where list_id = @list_id
|
list lc pick work summary information
 where list_id = @list_id
   and dspprt = @dspprt
   and dsploc = @dsploc catch(-1403) >>res
|
publish top rows
 where res = @res
   and rows = 1




]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-63062
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2026-02-05
    <p>
    This command is used to list lc pick list summary information.
    </p>
]]>
</remarks>
</documentation>
</command>