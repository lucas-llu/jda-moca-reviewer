<command>
  <name>get lc rcvlin inv snapshot rm</name>
  <description>get lc rcvlin inv snapshot rm</description>
  <type>Local Syntax</type>
  <local-syntax>
<![CDATA[
get warehouse id
|
If (@lodnum is NULL)
{
    /*Moca command does not have the correct filter*/
    /*View not exists*/
    [select all_inventory_view.prt_client_id,
            all_inventory_view.prtnum,
            sum(all_inventory_view.untqty) untqty,
            all_inventory_view.invsts
       from all_inventory_view
      where rcvkey in (select rcvkey
                         from rcvlin
                        where trknum = @trknum
                          and supnum = @supnum
                          and invnum = @invnum
                          and invlin = @invlin
                          and invsln = @invsln)
        and wh_id = @wh_id
      group by all_inventory_view.prt_client_id,
            all_inventory_view.prtnum,
            all_inventory_view.invsts]
}
else
{
    list inventory
     where lodnum = @lodnum
       and wh_id = @wh_id
}
]]>
</local-syntax>
</command>