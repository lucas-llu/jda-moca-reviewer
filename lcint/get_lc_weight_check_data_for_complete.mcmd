<command>
  <name>get lc weight check data for complete</name>
  <description>get lc weight check data for complete</description>
  <type>Local Syntax</type>
  <local-syntax>
    
<![CDATA[

/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables. */
[select tbl.pick_usr_id,
        tbl.ordnum,
        tbl.ship_id,
        tbl.dstloc,
        tbl.client_id
   from(select pv.last_pck_usr_id pick_usr_id,
            pv.ordnum,
            pv.ship_id,
            pm.stoloc dstloc,
            pv.client_id
       from pckwrk_view pv
       join pckmov pm
         on pm.cmbcod = pv.cmbcod
       join inventory_view iv
         on iv.wrkref_dtl = pv.wrkref_dtl
      where iv.subnum = @subnum
        and pv.wh_id = @wh_id
      order by pm.seqnum desc) tbl
  where rownum = 1]

]]>    
  </local-syntax>
  <argument name="wh_id" required="yes" datatype="string">Warehouse ID</argument>
  <argument name="subnum" required="yes" datatype="string">Sub-LPN</argument>
  <documentation>
    <remarks>
      @author Kevin Wang
      @since 2025-10-24
      SWIFTLEX-57791
      get lc weight check data for complete
    </remarks>
  </documentation>
</command>
