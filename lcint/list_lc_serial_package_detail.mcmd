<command>
  <name>list lc serial package detail</name>
  <description>list lc serial package detail</description>
  <type>Local Syntax</type>
  <local-syntax> 
<![CDATA[

/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables.
 */
[select ipv.wrkref,
        ipv.wh_id,
        ipv.prtnum,
        ipv.prt_client_id
   from inventory_pckwrk_view ipv
  where ipv.subnum = @subnum
  group by ipv.wrkref,
        ipv.wh_id,
        ipv.prtnum,
        ipv.prt_client_id]

]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-67708
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2026-03-31
    <p>
    This command is used to list lc serial package detail.
    </p>
]]>
</remarks>
</documentation>
</command>
