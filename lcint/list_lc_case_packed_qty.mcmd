<command>
<name>list lc case packed qty</name>
<description>list lc case packed qty</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

/* No existing MOCA list command, use select statement instead. 
 * Use poldat instead of poldat_view for better performance. 
 */
[select sum(ipv.untqty) case_packed_qty
   from inventory_pckwrk_view ipv
   join poldat p
     on p.wh_id_tmpl = ipv.wh_id
    and p.polcod = 'LC_IN'
    and p.polvar = 'CASE_INSPECTION'
    and p.polval = 'MOVEMENT_ZONE_CODE'
    and p.rtstr1 = ipv.client_id
   join locmst
     on locmst.stoloc = ipv.stoloc
    and locmst.wh_id = ipv.wh_id
   join mov_zone
     on mov_zone.mov_zone_id = locmst.mov_zone_id
    and mov_zone.mov_zone_cod = p.rtstr2
  where ipv.subnum = @subnum
    and ipv.client_id = @client_id]


]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-58488
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-10-14
    <p>
    This command is used to list lc case packed qty.
    </p>
]]>
</remarks>
</documentation>
</command>