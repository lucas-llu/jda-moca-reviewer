<command>
  <name>process lc weight check after scan weight</name>
  <description>process lc weight check after scan weight</description>
  <type>Local Syntax</type>
  <local-syntax>
    
<![CDATA[

/* handle the prtnum list for DCR_ITEM, NEW_ITEM and NO_GTIN_EAN policy condition check */
convert list
 where string = @prtnumList
   and separator = ','
   and type = 'S'
|
/* prtnum_in_clause will be like: "IN ('ITEM02','ITEM01')" */
publish data
 where prtnum_in_clause = 'IN (' || @retstr || ')'
|
check lc weight check carton need inspection
 where prtnum_in_clause = @prtnum_in_clause
   and wh_id = @wh_id
   and weight_diff = @weight_diff
   and custmor = @custmor
   and usr_id = @usr_id
   and lp_weight = @lp_weight
   and ctncod = @ctncod
|
if (@check_flag = 0)
{
    list policies
     where polcod = 'LC_WEIGHT_CHECK'
       and polvar = 'COMPLETE'
       and polval = 'AUTO_COMPLETE'
       and wh_id = @wh_id
       and rtstr1 = @client_id
       and rtnum1 = 1
       and rownum = 1 catch(-1403)
    |
    if (@? = 0)
    {
        process lc weight check complete
         where subnum = @subnum
           and wh_id = @wh_id
           and policy_condition = @policy_condition
           and ctncod = @ctncod
           and actual_weight = @actual_weight >> res
        |
        publish data
         where auto_complete_flag = 1
    }
    else
    {
        publish data
         where policy_condition = @policy_condition
           and check_flag = @check_flag
    }
}
else
{
    publish data
     where policy_condition = @policy_condition
       and check_flag = @check_flag
}

]]>    
  </local-syntax>
  <argument name="wh_id" required="yes" datatype="string">Warehouse ID</argument>
  <argument name="client_id" required="yes" datatype="string">Client ID</argument>
  <argument name="prtnumList" required="yes" datatype="string">Prtnum List</argument>
  <argument name="weight_diff" required="yes" datatype="float">Weight Difference</argument>
  <argument name="lp_weight" required="yes" datatype="float">Lightest Product Weight</argument>
  <argument name="usr_id" required="yes" datatype="string">User ID</argument>
  <argument name="custmor" required="yes" datatype="string">Customer Number</argument>
  <argument name="actual_weight" datatype="float">Actual Weight</argument>
  <argument name="ctncod" datatype="string">Carton Code</argument>
  <argument name="subnum" datatype="string">Sub-LPN</argument>
  <documentation>
    <remarks>
      @author Kevin Wang
      @since 2025-10-17
      SWIFTLEX-57791
      process lc weight check after scan weight
      an example of prtnumList: ITEM02,ITEM01
    </remarks>
  </documentation>
</command>
