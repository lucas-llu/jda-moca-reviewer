<command>
<name>list lc total qty in stage by shipment</name>
<description>list lc total qty in stage by shipment</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

    /* No existing MOCA list command, use select statement instead.
     * Retrieve data from some tables directly since there is no view for these tables.
     */ 
    [select nvl(sum(untqty), 0) tot_untqty
       from inventory_view 
       join locmst 
         on locmst.stoloc = inventory_view.stoloc
        and locmst.wh_id = inventory_view.wh_id
       join loc_typ
         on loc_typ.loc_typ_id = locmst.loc_typ_id
      where stgflg = 1
        and exists (select 'x' from shipment_line where ship_id = @ship_id and ship_line_id = inventory_view.ship_line_id)]
        
]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-63062
    @author Reko/Steven Chen
    @version 1.0.0
    @since 2026-03-20
    <p>
    This command is used to get the total qty in staging location by ship_id
    </p>
]]>
</remarks>
</documentation>
</command>