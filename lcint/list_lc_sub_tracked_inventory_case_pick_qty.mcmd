<command>
<name>list lc sub tracked inventory case pick qty</name>
<description>list lc sub tracked inventory case pick qty</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables.
 * Use decode to avoid divide by zero errors */
[select decode(prtftp_view.untcas, 0, 0, floor((ph.pckqty - ph.appqty) / prtftp_view.untcas)) cas_qty,
        prtmst.velzon
   from pckwrk_hdr ph
   join prtmst
     on prtmst.prtnum = ph.prtnum
    and prtmst.prt_client_id = ph.prt_client_id
    and prtmst.wh_id_tmpl = ph.wh_id
   join prtftp_view
     on ph.prtnum = prtftp_view.prtnum
    and ph.prt_client_id = prtftp_view.prt_client_id
    and ph.wh_id = prtftp_view.wh_id
    and ph.ftpcod = prtftp_view.ftpcod
  where wrkref = @wrkref]

]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-63062
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2026-02-03
    <p>
    This command is used to list lc sub tracked inventory case pick qty.
    </p>
]]>
</remarks>
</documentation>
</command>