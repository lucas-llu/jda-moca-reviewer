<command>
<name>process lc skip ctnnum validation</name>
<description>process lc skip ctnnum validation</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

publish data
 where wh_id = @wh_id
   and new_ctnnum = @subnum
   and wrkref = @wrkref
|
{
    list pick work
     where wrkref = @wrkref
       and wrktyp = 'K'
       and rownum = 1
    |
    publish data
     where client_id = @client_id
       and old_ctnnum = @subnum
}
|
if (@old_ctnnum <> @new_ctnnum)
{
    list policies
     where polcod = 'LC_CARTON_PICK'
       and polvar = 'SKIP_CARTON_VALIDATION'
       and polval = 'INSTALL'
       and wh_id = @wh_id
       and rtstr1 = @client_id
       and rtnum1 = 1 catch(-1403)
    |
    if (@? = 0)
    {
        {
            list pick work
             where wrkref = @wrkref
               and subnum = @old_ctnnum
            |
            publish data
             where wrkref = @wrkref
               and wrkref_dtl = @wrkref_dtl
        }
        |
        execute server command
         where cmd = "change record  where table = 'pckwrk_dtl'  and wrkref_dtl = '" || @wrkref_dtl || "' and wrkref = '" || @wrkref || "' and subnum = '" || @new_ctnnum || "'"
           and inline = 0
        |
        {
            list pick work
             where ctnnum = @old_ctnnum
               and wrktyp = 'P'
            |
            publish data
             where wrkref = @wrkref
        }
        |
        execute server command
         where cmd = "change record  where table = 'pckwrk_hdr'  and wrkref = '" || @wrkref || "' and ctnnum = '" || @new_ctnnum || "'"
           and inline = 0
    }
}


]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-58487
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-11-14
    <p>
    This command is used to process lc skip ctnnum validation.
    </p>
]]>
</remarks>
</documentation>
</command>