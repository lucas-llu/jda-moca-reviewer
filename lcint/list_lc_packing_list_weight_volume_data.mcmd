<command>
<name>list lc packing list weight volume data</name>
<description>list lc packing list weight volume data</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

/*SQL select statement used as no standard list command or view is available*/
[select distinct usr_uc_package_detail.uc_pkg_id,
        sl.ordnum ordnum,
        to_char(round(usr_uc_package_detail.uc_grswgt / 1000, 3), 'FM9999999990.000') grswgt,
        to_char(round(usr_uc_package_detail.uc_netwgt / 1000, 3), 'FM9999999990.000') netwgt,
        to_char(round(usr_uc_package_detail.uc_pkglen, 3), 'FM9999999990.000') pkglen,
        to_char(round(usr_uc_package_detail.uc_pkgwdt, 3), 'FM9999999990.000') pkgwdt,
        to_char(round(usr_uc_package_detail.uc_pkghgt, 3), 'FM9999999990.000') pkghgt,
        to_char(usr_uc_package_detail.uc_pkglen * usr_uc_package_detail.uc_pkgwdt * usr_uc_package_detail.uc_pkghgt, 'FM9999999990.000') volume,
        substr(aiv.subnum, -18) subnum
   from all_inventory_view aiv
   join shipment_line sl
     on aiv.ship_line_id = sl.ship_line_id
    and aiv.wh_id = sl.wh_id
   left
   join invsub
     on invsub.subnum = aiv.subnum
    and invsub.lodnum = aiv.lodnum
   left
   join invsub_hist
     on invsub_hist.subnum = aiv.subnum
    and invsub_hist.lodnum = aiv.lodnum
   join usr_uc_package_detail
     on usr_uc_package_detail.uc_pkg_id = nvl(invsub.uc_pkg_id, invsub_hist.uc_pkg_id)
  where sl.ship_id = @ship_id
  order by uc_pkg_id,
        subnum,
        ordnum]

]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-60323
    @author Reko/Lydia Luo
    @version 1.0.0
    @since 2025-11-20

    <p>
        This command is used to list packing list weight volume data for sub-report 2.
    </p>
]]>
</remarks>

</documentation>
</command>