<command>
<name>list lc serial capturing package detail</name>
<description>list lc serial capturing package detail</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables.
 */
[select ordnum,
        prtnum,
        lodnum,
        subnum,
        sum(untqty) total_qty
   from inventory_pckwrk_view
  where lodnum = @invtid
    and wh_id = @wh_id
  group by ordnum,
        prtnum,
        lodnum,
        subnum
 union
 select ordnum,
        prtnum,
        lodnum,
        subnum,
        sum(untqty) total_qty
   from inventory_pckwrk_view
  where subnum = @invtid
    and wh_id = @wh_id
  group by ordnum,
        prtnum,
        lodnum,
        subnum]
|
filter data
 where moca_filter_level = 1
   and scan_type = @pallet_type
   and scan_id = @scan_id
   and lodnum = decode(@pallet_type, 'lodnum', @lodnum, null)
   and subnum = decode(@pallet_type, 'subnum', @subnum, null)


]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-60057
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-11-20
    <p>
    This command is used to list lc serial capturing package detail.
    </p>
]]>
</remarks>
</documentation>
</command>