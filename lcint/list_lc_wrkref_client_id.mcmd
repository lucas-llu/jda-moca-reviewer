<command>
<name>list lc wrkref client id</name>
<description>list lc wrkref client id</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables.
 */
[select client_id
   from pckwrk_view
  where wrkref = @wrkref
    and rownum < 2]




]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-60987
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-10-22
    <p>
    This command is used to list lc wrkref client id.
    </p>
]]>
</remarks>
</documentation>
</command>