<command>
<name>list lc sscc relabel pick method</name>
<description>list lc sscc relabel pick method</description>
<type>Local Syntax</type>
<local-syntax>
<![CDATA[

/* No existing MOCA list command, use select statement instead.
 * Retrieve data from some tables directly since there is no view for these tables.
 */
[select pck_mthd.pck_mthd_nam
   from inventory_pckwrk_view
   join pckwrk_view
     on pckwrk_view.wrkref = inventory_pckwrk_view.wrkref
   join pck_mthd
     on pckwrk_view.pck_mthd_id = pck_mthd.pck_mthd_id
  where inventory_pckwrk_view.subnum = @invtid
    and rownum < 2]





]]>
</local-syntax>

<documentation>
<remarks>
<![CDATA[
    K+N reference for change: SWIFTLEX-60987
    @author Reko/Lucas Lu
    @version 1.0.0
    @since 2025-10-22
    <p>
    This command is used to list lc sscc relabel pick method.
    </p>
]]>
</remarks>
</documentation>
</command>